# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The Resend audience ID containing the contacts to invite
# Find this in the Resend dashboard under Audiences > [your audience]
AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Sender identity — must use a domain verified in Resend
FROM_EMAIL=invites@schwifty.com
FROM_NAME=Schwifty
REPLY_TO=hello@schwifty.com

# Where the personalized signup link points
# The script appends ?token=<unique-token> to this base URL
SIGNUP_BASE_URL=https://schwifty-adambursey-3058s-projects.vercel.app/sign-up

# Subject line
SUBJECT=You're invited to Schwifty

# Logo: leave LOGO_URL empty to inline the local file at ./public/schwifty-logo.png as base64
# (works in most clients; Gmail strips data URIs, so for production set LOGO_URL to a hosted image)
LOGO_URL=

# Set DRY_RUN=true to print what would be sent without actually sending
DRY_RUN=false

# Optional: throttle in ms between sends to stay under Resend's rate limit (default: 600ms => ~100/min)
SEND_INTERVAL_MS=600
