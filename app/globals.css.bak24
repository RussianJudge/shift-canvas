/* ============================================================
   Design tokens — clean minimal (SF-style), light + dark
   "Visual refresh 2026"
   ============================================================ */
:root {
  color-scheme: light dark;

  --font-display: -apple-system, BlinkMacSystemFont, "SF Pro Display",
    "Segoe UI", system-ui, "Helvetica Neue", sans-serif;
  --font-body: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI",
    system-ui, "Helvetica Neue", sans-serif;

  /* Canvas + surfaces */
  --bg: #f5f5f7;
  --bg-tint: #f0f0f3;
  --surface: #ffffff;
  --surface-2: #fbfbfd;
  --surface-strong: #ffffff;
  --surface-translucent: rgba(255, 255, 255, 0.72);

  /* Ink */
  --ink: #1d1d1f;
  --muted: #6e6e73;
  --faint: #8a8a8f;

  /* Lines */
  --line: rgba(0, 0, 0, 0.08);
  --line-strong: rgba(0, 0, 0, 0.14);

  /* Accent (brand orange, refined) */
  --accent: #f97316;
  --accent-strong: #ea580c;
  --accent-ink: #ffffff;
  --accent-soft: rgba(249, 115, 22, 0.12);
  --accent-ring: rgba(249, 115, 22, 0.28);
  --team-accent: var(--accent);

  /* Radii */
  --radius-sm: 0.625rem;
  --radius: 0.875rem;
  --radius-lg: 1.25rem;
  --radius-xl: 1.5rem;
  --radius-pill: 999px;

  /* Shadows — soft, layered */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 2px 4px rgba(0, 0, 0, 0.04), 0 8px 20px rgba(0, 0, 0, 0.07);
  --shadow-lg: 0 4px 8px rgba(0, 0, 0, 0.05), 0 18px 44px rgba(0, 0, 0, 0.12);
  --shadow: var(--shadow-lg);

  /* Scheduler grid semantic surfaces */
  --grid-cell: #ffffff;
  --grid-header: #fbfbfd;
  --grid-line: rgba(0, 0, 0, 0.07);
  --cell-day: #fff8ef;
  --cell-night: #eef4fc;
  --cell-off: #f4f4f6;
  --cell-weekend-veil: rgba(0, 0, 0, 0.015);
  --state-good: #16a34a;
  --state-good-soft: rgba(22, 163, 74, 0.12);
  --state-warn: #ea580c;
  --state-warn-soft: rgba(234, 88, 12, 0.12);
}

@media screen and (prefers-color-scheme: dark) {
  :root {
    --bg: #161618;
    --bg-tint: #1c1c1f;
    --surface: #242427;
    --surface-2: #1e1e21;
    --surface-strong: #2a2a2e;
    --surface-translucent: rgba(40, 40, 44, 0.66);

    --ink: #f5f5f7;
    --muted: #a1a1a6;
    --faint: #8a8a8f;

    --line: rgba(255, 255, 255, 0.10);
    --line-strong: rgba(255, 255, 255, 0.18);

    --accent: #ff833d;
    --accent-strong: #ff9a5e;
    --accent-ink: #1a1003;
    --accent-soft: rgba(255, 131, 61, 0.16);
    --accent-ring: rgba(255, 131, 61, 0.36);

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
    --shadow-md: 0 2px 6px rgba(0, 0, 0, 0.45), 0 10px 24px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 6px 14px rgba(0, 0, 0, 0.5), 0 22px 50px rgba(0, 0, 0, 0.55);

    --grid-cell: #242427;
    --grid-header: #2a2a2e;
    --grid-line: rgba(255, 255, 255, 0.08);
    --cell-day: #2c2820;
    --cell-night: #20262f;
    --cell-off: #242427;
    --cell-weekend-veil: rgba(255, 255, 255, 0.02);
    --state-good: #4ade80;
    --state-good-soft: rgba(74, 222, 128, 0.16);
    --state-warn: #ff9a5e;
    --state-warn-soft: rgba(255, 154, 94, 0.16);
  }
}

* {
  box-sizing: border-box;
}

html {
  background:
    radial-gradient(110% 70% at 50% -10%, var(--bg-tint), transparent 60%),
    var(--bg);
  background-attachment: fixed;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  font-family: var(--font-body), sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.005em;
}

a {
  color: inherit;
}

button,
input,
select {
  font: inherit;
}

.shell {
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  padding: 0;
  overflow: hidden;
}

.workspace-frame {
  max-width: 100%;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  overflow: hidden;
  backdrop-filter: none;
  display: grid;
  grid-template-columns: 16rem minmax(0, 1fr);
}

.workspace-frame--collapsed {
  grid-template-columns: 4.75rem minmax(0, 1fr);
}

.workspace-sidebar {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 1.4rem 1rem;
  border-right: 1px solid var(--line);
  background:
    linear-gradient(180deg, rgba(255, 252, 248, 0.95), rgba(245, 236, 223, 0.85));
}

.workspace-sidebar--collapsed {
  width: 4.75rem;
}

.workspace-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.workspace-brand {
  display: grid;
  gap: 0.4rem;
  padding: 0.6rem 0.75rem;
}

.brand-lockup {
  display: grid;
  gap: 0.45rem;
  align-items: start;
}

.brand-lockup--compact {
  gap: 0.3rem;
}

.brand-lockup__logo {
  width: min(11.5rem, 100%);
  height: auto;
  object-fit: contain;
  display: block;
}

.brand-lockup--compact .brand-lockup__logo {
  width: min(8.75rem, 100%);
}

.workspace-brand span,
.panel-eyebrow {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
}

.workspace-brand strong {
  font-family: var(--font-display), sans-serif;
  font-size: 1.4rem;
  font-weight: 600;
}

.workspace-session {
  display: grid;
  gap: 0.8rem;
  margin-top: auto;
  padding: 0.9rem 0.75rem 0.35rem;
  border-top: 1px solid var(--line);
}

.workspace-sidebar-bottom {
  display: grid;
  gap: 0.75rem;
  margin-top: auto;
}

.workspace-sidebar-bottom .workspace-session {
  margin-top: 0;
}

.workspace-session__meta {
  display: grid;
  gap: 0.2rem;
}

.workspace-session__meta strong {
  font-size: 0.92rem;
}

.workspace-session__meta span {
  color: var(--muted);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.workspace-session__signout {
  width: 100%;
}

.workspace-admin-scope {
  display: grid;
  gap: 0.7rem;
  padding: 0.7rem;
  min-width: 0;
  border-radius: 1rem;
  background: rgba(255, 255, 255, 0.52);
  border: 1px solid var(--line);
}

.workspace-admin-scope--collapsed {
  gap: 0;
}

.workspace-admin-scope__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  width: 100%;
  padding: 0.25rem;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.workspace-admin-scope__toggle:hover .workspace-admin-scope__chevron {
  background: rgba(255, 255, 255, 0.88);
  border-color: color-mix(in srgb, var(--team-accent) 18%, var(--line));
}

.workspace-admin-scope__fields {
  display: grid;
  gap: 0.65rem;
  min-width: 0;
}

.workspace-admin-scope__heading {
  display: grid;
  gap: 0.2rem;
  min-width: 0;
}

.workspace-admin-scope__heading strong {
  font-size: 0.92rem;
}

.workspace-admin-scope__heading span {
  color: var(--muted);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.workspace-admin-scope__chevron {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 1.7rem;
  height: 1.7rem;
  border-radius: 0.7rem;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid var(--line);
  transition:
    transform 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
}

.workspace-admin-scope--collapsed .workspace-admin-scope__chevron {
  transform: rotate(-90deg);
}

.workspace-admin-scope__chevron svg {
  width: 0.9rem;
  height: 0.9rem;
  stroke: currentColor;
  stroke-width: 2;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.workspace-admin-scope__field {
  min-width: 0;
}

.workspace-admin-scope__field select {
  min-width: 0;
}

.sidebar-toggle {
  width: 1.9rem;
  height: 1.9rem;
  border: 1px solid var(--line);
  border-radius: 0.8rem;
  background: rgba(255, 255, 255, 0.58);
  color: var(--ink);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  transition:
    transform 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
}

.sidebar-toggle:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.82);
  border-color: color-mix(in srgb, var(--team-accent) 14%, var(--line));
}

.sidebar-toggle svg {
  width: 1rem;
  height: 1rem;
  stroke: currentColor;
  stroke-width: 1.8;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.workspace-nav {
  display: grid;
  gap: 0.5rem;
}

.workspace-nav-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0;
  border-radius: 1rem;
  color: inherit;
  text-decoration: none;
  border: 1px solid transparent;
}

button.workspace-nav-link {
  width: 100%;
  background: transparent;
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.workspace-nav-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 0.8rem;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid var(--line);
  flex: 0 0 auto;
}

.workspace-nav-icon svg {
  width: 1rem;
  height: 1rem;
  stroke: currentColor;
  stroke-width: 1.8;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.workspace-nav-link strong {
  font-size: 0.95rem;
}

.workspace-nav-link--active {
  background: rgba(255, 255, 255, 0.78);
  border-color: color-mix(in srgb, var(--team-accent) 20%, var(--line));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
}

.workspace-nav-notifications {
  margin-top: 0.15rem;
  padding-top: 0.65rem;
  border-top: 1px solid color-mix(in srgb, var(--line) 86%, transparent);
}

.workspace-notifications__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 1.25rem;
  height: 1.25rem;
  padding: 0 0.35rem;
  border-radius: 999px;
  background: #f97316;
  color: white;
  font-size: 0.72rem;
  font-weight: 700;
  margin-left: auto;
}

.workspace-notification-item {
  display: grid;
  gap: 0.25rem;
  padding: 0.8rem;
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  background: rgba(255, 255, 255, 0.58);
}

.workspace-notification-item span,
.workspace-notification-item small {
  color: var(--muted);
  font-size: 0.78rem;
}

.notifications-page-list {
  display: grid;
  gap: 0.75rem;
  padding: 1rem;
}

.notifications-page-list__item {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
}

.notifications-page-list__item:not(.workspace-notification-item--read) {
  border-color: color-mix(in srgb, var(--team-accent) 62%, var(--line));
  box-shadow:
    0 0 0 2px color-mix(in srgb, var(--team-accent) 18%, transparent),
    0 12px 28px color-mix(in srgb, var(--team-accent) 12%, transparent);
}

.notifications-page-list__content {
  display: grid;
  gap: 0.25rem;
  min-width: 0;
  width: 100%;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
  padding: 0;
  text-align: left;
}

.notifications-page-list__view-form {
  min-width: 0;
}

.notifications-page-list__item form:not(.notifications-page-list__view-form) {
  display: inline-flex;
  justify-self: end;
}

.workspace-notification-item--read {
  opacity: 0.72;
}

.notifications-page-list__content:hover strong {
  text-decoration: underline;
  text-decoration-thickness: 0.08em;
  text-underline-offset: 0.18em;
}

.workspace-content {
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  padding: 1.25rem;
  min-width: 0;
  overflow: auto;
  overscroll-behavior: contain;
}

.workspace-mobile-toolbar,
.workspace-mobile-backdrop {
  display: none;
}

.workspace-mobile-toolbar {
  padding: 0 0 0.9rem;
}

.workspace-mobile-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
}

.workspace-mobile-toggle__icon {
  background: rgba(255, 255, 255, 0.72);
}

.panel-frame {
  min-height: 100%;
  border-radius: 1.5rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 249, 240, 0.88)),
    var(--surface);
  border: 1px solid rgba(255, 255, 255, 0.68);
  overflow: hidden;
}

.landing-shell {
  display: grid;
  gap: 0;
  min-height: 100vh;
}

.landing-hero,
.landing-band,
.landing-detail,
.landing-cta {
  padding-inline: clamp(1.2rem, 5vw, 4rem);
}

.landing-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
  gap: 2rem;
  align-items: stretch;
  min-height: 100vh;
  padding-block: clamp(1.5rem, 4vw, 3rem);
}

.landing-hero__copy {
  display: grid;
  align-content: center;
  gap: 1.2rem;
  max-width: 34rem;
}

.landing-kicker,
.landing-band__label {
  color: var(--muted);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

.landing-hero__copy h1,
.landing-band h2,
.landing-detail h2,
.landing-cta h2 {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  line-height: 0.96;
  letter-spacing: -0.05em;
}

.landing-hero__copy h1 {
  font-size: clamp(3.4rem, 8vw, 6.8rem);
}

.landing-hero__copy p,
.landing-band p,
.landing-detail p,
.landing-cta p {
  margin: 0;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.65;
}

.landing-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.landing-hero__visual {
  display: grid;
  align-items: stretch;
}

.landing-blueprint {
  min-height: 28rem;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 1.1rem;
  padding: clamp(1.2rem, 3vw, 2rem);
  border: 1px solid rgba(255, 255, 255, 0.46);
  border-radius: 2rem;
  background:
    linear-gradient(180deg, rgba(20, 27, 38, 0.9), rgba(36, 48, 68, 0.92)),
    radial-gradient(circle at top right, rgba(251, 191, 36, 0.18), transparent 30%);
  color: #f8f3ea;
  box-shadow: 0 24px 60px rgba(12, 18, 28, 0.28);
}

.landing-blueprint__rail,
.landing-blueprint__grid,
.landing-blueprint__roles {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 1.2rem;
  background: rgba(255, 255, 255, 0.03);
}

.landing-blueprint__rail,
.landing-blueprint__roles {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.1rem;
}

.landing-blueprint__grid {
  display: grid;
  align-content: space-between;
  padding: 1.1rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01)),
    linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px),
    linear-gradient(180deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
  background-size: auto, 3.2rem 3.2rem, 3.2rem 3.2rem;
}

.landing-blueprint strong,
.landing-role-grid strong,
.landing-columns strong {
  font-size: 1rem;
}

.landing-blueprint span,
.landing-role-grid span {
  color: rgba(248, 243, 234, 0.72);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.landing-blueprint__roles {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.landing-blueprint__roles div,
.landing-role-grid article,
.landing-columns article {
  display: grid;
  gap: 0.35rem;
}

.landing-band,
.landing-detail,
.landing-cta {
  padding-block: 3.5rem;
}

.landing-band {
  display: grid;
  gap: 1.8rem;
  background: rgba(255, 250, 242, 0.52);
  border-top: 1px solid rgba(255, 255, 255, 0.45);
  border-bottom: 1px solid var(--line);
}

.landing-columns,
.landing-role-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.2rem;
}

.landing-detail {
  display: grid;
  gap: 1.8rem;
}

.landing-role-grid article {
  padding: 1.2rem 0 0;
  border-top: 1px solid var(--line);
}

.landing-role-grid span {
  color: var(--muted);
}

.landing-cta {
  display: grid;
  gap: 1rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.44), rgba(250, 243, 234, 0.76)),
    rgba(255, 250, 242, 0.52);
}

.auth-shell {
  display: grid;
  place-items: center;
  min-height: 100vh;
  padding: 1.5rem;
}

.auth-home {
  display: grid;
  place-items: center;
  min-height: 100vh;
  padding: 1.5rem;
}

.auth-home__panel {
  width: min(28rem, 100%);
  display: grid;
  gap: 1.4rem;
  padding: 1.6rem;
  border: 1px solid rgba(255, 255, 255, 0.62);
  border-radius: 1.7rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 249, 240, 0.92)),
    var(--surface);
  box-shadow: var(--shadow);
}

.auth-home__copy {
  display: grid;
  gap: 0.85rem;
}

.auth-home__title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: clamp(1.5rem, 5vw, 2.8rem);
  line-height: 1;
  letter-spacing: -0.04em;
}

.auth-home__subtitle {
  margin: 0;
  color: var(--muted);
  font-size: 0.96rem;
  line-height: 1.55;
}

.auth-home__actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.8rem;
}

.auth-home__actions .primary-button,
.auth-home__actions .ghost-button {
  width: 100%;
}

.auth-home__links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem 1rem;
  color: var(--muted);
  font-size: 0.9rem;
}

.auth-home__links a {
  color: inherit;
  text-decoration: underline;
  text-decoration-color: color-mix(in srgb, var(--team-accent) 35%, transparent);
  text-underline-offset: 0.18rem;
}

.auth-panel {
  width: min(32rem, 100%);
  display: grid;
  gap: 1.25rem;
  padding: 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.62);
  border-radius: 1.7rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.56), rgba(255, 249, 240, 0.9)),
    var(--surface);
  box-shadow: var(--shadow);
}

.auth-panel__copy {
  display: grid;
  gap: 0.75rem;
}

.auth-eyebrow {
  color: var(--muted);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

.auth-title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: clamp(2.3rem, 6vw, 3.2rem);
  line-height: 0.96;
  letter-spacing: -0.04em;
}

.auth-subtitle {
  margin: 0;
  color: var(--muted);
}

.auth-form {
  display: grid;
  gap: 0.95rem;
}

.auth-name-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.8rem;
}

.auth-error {
  margin: 0;
  color: #b91c1c;
  font-size: 0.9rem;
}

.auth-notice {
  margin: 0;
  color: #166534;
  font-size: 0.9rem;
}

.auth-mode-switch {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  color: var(--muted);
  font-size: 0.92rem;
}

.auth-mode-switch--single {
  display: block;
}

.auth-mode-switch__full-button {
  width: 100%;
}

.auth-mode-actions {
  display: grid;
  gap: 0.75rem;
}

.auth-selection-note {
  display: grid;
  gap: 0.2rem;
  padding: 0.9rem 1rem;
  border-radius: 1rem;
  background: rgba(255, 252, 247, 0.84);
  border: 1px solid var(--line);
}

.auth-selection-note span {
  color: var(--muted);
  font-size: 0.82rem;
}

.auth-submit {
  width: 100%;
}

.auth-directory {
  display: grid;
  gap: 0.8rem;
  padding-top: 0.2rem;
}

.auth-directory__header {
  display: grid;
  gap: 0.15rem;
}

.auth-directory__header span {
  color: var(--muted);
  font-size: 0.84rem;
}

.auth-directory__list {
  display: grid;
  gap: 0.7rem;
}

.auth-account {
  display: grid;
  gap: 0.35rem;
  padding: 0.95rem 1rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 252, 247, 0.78);
}

.auth-account div {
  display: grid;
  gap: 0.18rem;
}

.auth-account__role {
  color: var(--muted);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.auth-account p {
  margin: 0;
  color: var(--muted);
  font-size: 0.88rem;
  line-height: 1.55;
}

.auth-switch {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.auth-switch a {
  color: var(--ink);
  text-decoration: underline;
  text-decoration-color: color-mix(in srgb, var(--team-accent) 40%, transparent);
  text-underline-offset: 0.18rem;
}

.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.85rem;
  padding: 0 1.5rem 1rem;
}

.profile-card {
  display: grid;
  gap: 0.25rem;
  padding: 1rem 1.05rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 252, 247, 0.82);
}

.profile-card strong {
  font-size: 1rem;
}

.profile-label {
  color: var(--muted);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.profile-section {
  display: grid;
  gap: 0.8rem;
  padding: 0 1.5rem 1.5rem;
}

.profile-section--password {
  align-items: center;
  grid-template-columns: minmax(0, 1fr) auto;
  padding-top: 1rem;
  border-top: 1px solid var(--line);
}

.profile-section--password div {
  display: grid;
  gap: 0.25rem;
}

.profile-section--password p {
  grid-column: 1 / -1;
  margin: 0;
}

.panel-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
  gap: 1rem;
  align-items: center;
  padding: 1.25rem 1.5rem 1rem;
}

.panel-heading--simple {
  grid-template-columns: 1fr;
}

.panel-heading--split {
  grid-template-columns: minmax(0, 1fr) auto;
}

.panel-title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  line-height: 1;
  letter-spacing: -0.04em;
}

.schedule-heading-month {
  display: inline-grid;
  grid-template-columns: 2.75rem minmax(12rem, auto) 2.75rem;
  align-items: stretch;
  justify-self: start;
  border: 1px solid color-mix(in srgb, var(--team-accent) 34%, var(--line));
  border-radius: 1rem;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
}

.schedule-heading-month__label {
  display: grid;
  place-items: center;
  padding: 0.55rem 1.1rem 0.65rem;
  border-inline: 1px solid color-mix(in srgb, var(--team-accent) 24%, var(--line));
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--team-accent) 7%, white), rgba(255, 255, 255, 0.8));
  text-align: center;
}

.schedule-heading-month__button {
  border: 0;
  padding: 0;
  background: color-mix(in srgb, var(--team-accent) 10%, white);
  color: var(--ink);
  font: 800 1.7rem/1 var(--font-display), sans-serif;
  cursor: pointer;
  transition:
    background-color 160ms ease,
    color 160ms ease;
}

.schedule-heading-month__button:hover {
  background: color-mix(in srgb, var(--team-accent) 22%, white);
  color: color-mix(in srgb, var(--team-accent) 72%, var(--ink));
}

.app-date-selector {
  position: relative;
  justify-self: start;
  z-index: 12;
}

.app-date-selector__trigger {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.25rem 0.75rem;
  min-width: min(22rem, 100%);
  padding: 0.7rem 0.9rem;
  border: 1px solid color-mix(in srgb, var(--team-accent) 28%, var(--line));
  border-radius: 1rem;
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--team-accent) 8%, white), rgba(255, 255, 255, 0.86)),
    var(--surface);
  color: var(--ink);
  cursor: pointer;
  text-align: left;
  box-shadow: 0 14px 30px rgba(23, 20, 17, 0.08);
}

.app-date-selector__trigger:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

.app-date-selector__trigger strong {
  min-width: 0;
  font-family: var(--font-display), sans-serif;
  font-size: clamp(1.15rem, 2vw, 1.55rem);
  line-height: 1;
  letter-spacing: -0.035em;
}

.app-date-selector__trigger svg {
  grid-row: 1 / span 2;
  grid-column: 2;
  width: 1.05rem;
  height: 1.05rem;
  stroke: currentColor;
  stroke-width: 2;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.app-date-selector__eyebrow {
  color: var(--muted);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.app-date-selector__popover {
  position: absolute;
  top: calc(100% + 0.55rem);
  left: 0;
  z-index: 40;
  width: min(22rem, calc(100vw - 2rem));
  display: grid;
  gap: 0.85rem;
  padding: 0.9rem;
  border: 1px solid rgba(23, 20, 17, 0.12);
  border-radius: 1.1rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 248, 238, 0.96)),
    var(--surface);
  box-shadow: 0 24px 60px rgba(23, 20, 17, 0.18);
}

.panel-heading--split .app-date-selector {
  justify-self: end;
}

.panel-heading--split .app-date-selector__popover {
  right: 0;
  left: auto;
}

.workspace-toolbar .app-date-selector__trigger {
  min-width: min(18rem, 100%);
}

.workspace-toolbar .app-date-selector__trigger strong {
  font-size: 1rem;
  letter-spacing: -0.015em;
}

.app-date-selector__header {
  display: grid;
  grid-template-columns: 2.35rem minmax(0, 1fr) 2.35rem;
  align-items: center;
  gap: 0.45rem;
}

.app-date-selector__header strong {
  text-align: center;
  font-family: var(--font-display), sans-serif;
  font-size: 1.1rem;
}

.app-date-selector__header button,
.app-date-selector__option {
  border: 1px solid var(--line);
  border-radius: 0.8rem;
  background: rgba(255, 255, 255, 0.72);
  color: var(--ink);
  cursor: pointer;
  font-weight: 800;
}

.app-date-selector__header button {
  min-height: 2.35rem;
  font: 900 1.45rem/1 var(--font-display), sans-serif;
}

.app-date-selector__grid {
  display: grid;
  gap: 0.45rem;
}

.app-date-selector__grid--months {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.app-date-selector__grid--years {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.app-date-selector__option {
  min-height: 2.55rem;
  padding: 0.45rem 0.55rem;
}

.app-date-selector__header button:hover,
.app-date-selector__option:hover {
  border-color: color-mix(in srgb, var(--team-accent) 35%, var(--line));
  background: color-mix(in srgb, var(--team-accent) 12%, white);
}

.app-date-selector__option--selected {
  border-color: color-mix(in srgb, var(--team-accent) 72%, var(--line));
  background: color-mix(in srgb, var(--team-accent) 18%, white);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--team-accent) 42%, transparent);
}

.app-date-selector__option:disabled {
  cursor: not-allowed;
  opacity: 0.35;
}

.planner-actions--schedule {
  justify-content: flex-end;
}

.schedule-temporary-loan-button svg,
.schedule-order-button svg,
.schedule-print-button svg {
  width: 1.55rem;
  height: 1.55rem;
}

.schedule-temporary-loan-button svg,
.schedule-order-button svg {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.planner-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.planner-actions__row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.month-indicator {
  display: inline-flex;
  align-items: center;
  padding: 0 0.2rem;
  color: var(--muted);
  font-size: 0.92rem;
  font-weight: 600;
}

.primary-button,
.ghost-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.9rem;
  padding: 0 1rem;
  border-radius: 999px;
  border: 1px solid transparent;
  transition:
    transform 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
  cursor: pointer;
}

.primary-button:hover,
.ghost-button:hover {
  transform: translateY(-1px);
}

.primary-button {
  background: var(--team-accent);
  color: white;
}

.primary-button:disabled,
.ghost-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
  transform: none;
}

.ghost-button {
  background: rgba(255, 255, 255, 0.7);
  border-color: var(--line);
  color: var(--ink);
}

.ghost-button--active {
  background: color-mix(in srgb, var(--team-accent) 12%, white);
  border-color: color-mix(in srgb, var(--team-accent) 38%, white);
}

.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  justify-self: end;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.7);
  color: var(--ink);
  cursor: pointer;
  text-decoration: none;
  transition:
    transform 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
}

.ghost-button.icon-button {
  min-height: 2.75rem;
  padding: 0;
}

.ghost-button.icon-button.schedule-print-button {
  padding-left: 8px;
  padding-right: 8px;
}

.icon-button:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.9);
  border-color: color-mix(in srgb, var(--team-accent) 30%, var(--line));
}

.icon-button svg {
  width: 1.15rem;
  height: 1.15rem;
  stroke: currentColor;
  stroke-width: 1.8;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.notification-delete-button {
  width: 2.35rem;
  height: 2.35rem;
  color: #9f2f1d;
}

.notification-delete-button:hover {
  background: rgba(255, 241, 232, 0.9);
  border-color: rgba(159, 47, 29, 0.28);
}

.summary-row {
  display: grid;
  grid-template-columns: repeat(6, minmax(8rem, 1fr));
  gap: 0.75rem;
  padding: 0 1.5rem 1rem;
}

.summary-stat {
  display: grid;
  gap: 0.35rem;
  padding: 1rem;
  background: rgba(255, 252, 247, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.68);
  border-radius: 1.15rem;
}

.summary-stat span {
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.summary-stat strong {
  font-family: var(--font-display), sans-serif;
  font-size: 1.1rem;
  font-weight: 600;
}

.workspace-toolbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(14rem, 18rem)) minmax(0, 1fr);
  gap: 0.9rem;
  align-items: end;
  padding: 0 1.5rem 1rem;
  margin-bottom: 1rem;
}

.field {
  display: grid;
  gap: 0.45rem;
}

.field--static {
  align-content: start;
}

.field span {
  font-size: 0.8rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.field--static strong {
  min-height: 2.65rem;
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 0.85rem;
  border-radius: 0.95rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.field select,
.field input,
.assignment-field select {
  width: 100%;
  min-height: 2.65rem;
  border-radius: 0.95rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  color: var(--ink);
  padding: 0.6rem 0.8rem;
  outline: none;
}

.field select:focus,
.field input:focus,
.assignment-field select:focus {
  border-color: color-mix(in srgb, var(--team-accent) 70%, white);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--team-accent) 18%, transparent);
}

.workspace-copy {
  display: grid;
  gap: 0.3rem;
  padding: 0.85rem 1rem;
  border-left: 1px solid var(--line);
}

.workspace-copy strong {
  font-weight: 600;
}

.workspace-copy p {
  margin: 0;
  color: var(--muted);
}

.workspace-toolbar--personnel {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
}

.workspace-toolbar--actions {
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
}

.workspace-toolbar--actions .planner-actions {
  align-items: flex-end;
}

.workspace-toolbar--personnel-page {
  grid-template-columns: repeat(2, minmax(12rem, 16rem)) auto minmax(0, 1fr);
  align-items: end;
}

.personnel-toolbar-actions {
  justify-content: flex-end;
  align-items: center;
}

.personnel-actions-menu {
  position: relative;
}

.personnel-actions-menu__panel {
  position: absolute;
  top: calc(100% + 0.45rem);
  right: 0;
  z-index: 20;
  display: grid;
  gap: 0.35rem;
  min-width: 13rem;
  padding: 0.45rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 252, 247, 0.98);
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.12);
}

.personnel-actions-menu__item {
  justify-content: flex-start;
  width: 100%;
}

.workspace-toolbar--overtime {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr));
  align-items: end;
}

.workspace-toolbar--overtime .planner-actions,
.workspace-toolbar--overtime .toolbar-status-wrap {
  grid-column: 1 / -1;
}

.workspace-toolbar--overtime .field,
.workspace-toolbar--overtime .field--static,
.workspace-toolbar--overtime .toolbar-actions {
  min-width: 0;
}

.workspace-toolbar--overtime .toolbar-actions {
  justify-content: flex-start;
}

.overtime-toolbar-actions {
  grid-column: 1 / -1;
  width: 100%;
  align-items: center;
  gap: 0.55rem;
  overflow-x: auto;
}

.overtime-toolbar-button {
  flex: 0 0 auto;
  gap: 0.45rem;
  min-height: 2.75rem;
  padding-inline: 0.8rem;
  white-space: nowrap;
}

.overtime-toolbar-button span {
  white-space: nowrap;
}

.overtime-toolbar-button svg {
  width: 1.1rem;
  height: 1.1rem;
  stroke: currentColor;
  stroke-width: 1.9;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.workspace-toolbar--overtime .toolbar-status-wrap {
  justify-content: flex-start;
}

.workspace-toolbar--metrics {
  grid-template-columns: minmax(12rem, 16rem);
}

.metrics-month-nav {
  display: grid;
  width: fit-content;
  justify-self: end;
  justify-items: center;
  gap: 0.75rem;
}

.metrics-month-nav__current strong {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.65rem;
  padding: 0.6rem 0.85rem;
  border-radius: 0.95rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.metrics-month-nav__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.75rem;
}

.workspace-toolbar--scheduler {
  grid-template-columns: repeat(3, minmax(0, 16rem)) minmax(0, 1fr);
}

.workspace-copy--full {
  border-left: 0;
  padding-left: 0;
}

.toolbar-status-wrap {
  display: flex;
  justify-content: flex-end;
}

.toolbar-actions {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
}

.toolbar-status {
  margin: 0;
  color: var(--muted);
  font-size: 0.92rem;
  line-height: 1.4;
}

.set-builder {
  display: grid;
  gap: 0.9rem;
  padding: 0 1.5rem 1rem;
}

.set-builder__surface {
  display: grid;
  gap: 0.95rem;
  padding: 1rem 1.1rem;
  border: 1px solid color-mix(in srgb, var(--team-accent) 16%, var(--line));
  border-radius: 1rem;
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--team-accent) 8%, white) 0%, rgba(255, 255, 255, 0.94) 100%);
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.05);
}

.set-builder-heading {
  display: grid;
  gap: 0.8rem;
  justify-items: center;
}

.set-builder-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
}

.set-builder-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.55rem;
}

.set-builder-legend__item {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.55rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
  font-size: 0.72rem;
  color: var(--muted);
}

.set-builder-legend__item--under {
  background: rgba(148, 163, 184, 0.18);
}

.set-builder-legend__item--ot {
  box-shadow: inset 0 0 0 2px var(--line);
}

.set-builder-title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: 1.05rem;
  letter-spacing: -0.03em;
}

.set-builder-context {
  margin: 0.2rem 0 0;
  color: var(--muted);
  font-size: 0.86rem;
}

.set-builder-pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.65rem;
}

.legend-row {
  display: flex;
  gap: 0.65rem;
  flex-wrap: wrap;
  padding: 0 1.5rem 1rem;
}

.legend-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
  border: 0;
}

.legend-pill--amber {
  background: rgba(251, 191, 36, 0.16);
  color: #8a4b00;
}

.legend-pill--teal {
  background: rgba(20, 184, 166, 0.16);
  color: #0f766e;
}

.legend-pill--violet {
  background: rgba(139, 92, 246, 0.14);
  color: #6d28d9;
}

.legend-pill--rose {
  background: rgba(244, 63, 94, 0.13);
  color: #be123c;
}

.legend-pill--blue {
  background: rgba(37, 99, 235, 0.13);
  color: #1d4ed8;
}

.legend-pill--lime {
  background: rgba(132, 204, 22, 0.16);
  color: #4d7c0f;
}

.legend-pill--orange {
  background: rgba(249, 115, 22, 0.16);
  color: #c2410c;
}

.legend-pill--slate {
  background: rgba(100, 116, 139, 0.14);
  color: #334155;
}

.metrics-grid {
  display: grid;
  gap: 1rem;
  padding: 0 1.5rem 1.5rem;
}

.metrics-page-title {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
}

.metrics-settings-button svg {
  width: 1.05rem;
  height: 1.05rem;
}

.metrics-settings-modal {
  width: min(46rem, 100%);
}

.metrics-settings-modal__group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.metrics-settings-modal__group-heading .ghost-button {
  min-height: 2rem;
  padding: 0.35rem 0.7rem;
  font-size: 0.74rem;
}

.metrics-settings-modal__options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  gap: 0.45rem;
}

.metrics-settings-option {
  min-height: 3rem;
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.55rem 0.65rem;
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  background: rgba(255, 255, 255, 0.68);
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  transition:
    background 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease,
    transform 160ms ease;
}

.metrics-settings-option:hover {
  transform: translateY(-1px);
  border-color: color-mix(in srgb, var(--team-accent, #f97316) 34%, var(--line));
}

.metrics-settings-option--active {
  border-color: color-mix(in srgb, var(--team-accent, #f97316) 58%, white);
  background: color-mix(in srgb, var(--team-accent, #f97316) 10%, white);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--team-accent, #f97316) 20%, transparent);
}

.metrics-settings-option > span:not(.legend-pill) {
  color: var(--muted);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.metrics-settings-option strong {
  min-width: 0;
  font-size: 0.82rem;
}

.metrics-section {
  display: grid;
  gap: 0.85rem;
}

.metrics-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.metrics-section__title-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.85rem;
  padding-top: 0.35rem;
}

.metrics-section__controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
}

.metrics-window-toggle {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.metrics-field-inline {
  min-width: 15rem;
}

.metrics-section__title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: 1.2rem;
  line-height: 1;
}

.metrics-team-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  gap: 0.9rem;
}

.metrics-card {
  display: grid;
  gap: 0.9rem;
  padding: 1rem 1.1rem;
  border: 1px solid var(--line);
  border-radius: 1.15rem;
  background: rgba(255, 252, 247, 0.85);
}

.metrics-card--interactive {
  cursor: pointer;
  transition:
    transform 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.metrics-card--interactive:hover,
.metrics-card--interactive:focus-visible {
  border-color: color-mix(in srgb, var(--team-accent) 35%, var(--line));
  box-shadow: 0 0.9rem 2rem rgba(66, 44, 23, 0.08);
  transform: translateY(-1px);
}

.metrics-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.metrics-card__eyebrow {
  margin: 0 0 0.18rem;
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.metrics-card__title {
  margin-top: 0.5rem;
  font-family: var(--font-display), sans-serif;
  font-size: 1.15rem;
  line-height: 1.05;
}

.metrics-card__stats {
  display: grid;
  gap: 0.22rem;
  justify-items: end;
  color: var(--muted);
  font-size: 0.84rem;
  text-align: right;
}

.metrics-bars {
  display: grid;
  gap: 0.8rem;
}

.metrics-bar-row {
  display: grid;
  gap: 0.45rem;
}

.metrics-bar-row--interactive {
  padding: 0.2rem 0;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.metrics-bar-row--interactive:hover .metrics-bar-track,
.metrics-bar-row--interactive:focus-visible .metrics-bar-track {
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--team-accent) 25%, transparent);
}

.metrics-bar-row__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
}

.metrics-bar-row__label strong {
  font-size: 0.92rem;
}

.metrics-bar-track {
  position: relative;
  overflow: hidden;
  min-height: 0.85rem;
  border-radius: 999px;
  background: var(--line);
}

.metrics-bar-track--tall {
  min-height: 1rem;
}

.metrics-bar-fill {
  display: block;
  min-height: 100%;
  border-radius: inherit;
}

.metrics-bar-fill--amber {
  background: linear-gradient(90deg, rgba(251, 191, 36, 0.92), rgba(251, 191, 36, 0.45));
}

.metrics-bar-fill--teal {
  background: linear-gradient(90deg, rgba(20, 184, 166, 0.92), rgba(20, 184, 166, 0.45));
}

.metrics-bar-fill--violet {
  background: linear-gradient(90deg, rgba(139, 92, 246, 0.92), rgba(139, 92, 246, 0.45));
}

.metrics-bar-fill--rose {
  background: linear-gradient(90deg, rgba(244, 63, 94, 0.92), rgba(244, 63, 94, 0.45));
}

.metrics-bar-fill--blue {
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.92), rgba(37, 99, 235, 0.45));
}

.metrics-bar-fill--lime {
  background: linear-gradient(90deg, rgba(132, 204, 22, 0.92), rgba(132, 204, 22, 0.45));
}

.metrics-bar-fill--orange {
  background: linear-gradient(90deg, rgba(249, 115, 22, 0.92), rgba(249, 115, 22, 0.45));
}

.metrics-bar-fill--slate {
  background: linear-gradient(90deg, rgba(100, 116, 139, 0.92), rgba(100, 116, 139, 0.45));
}

.metrics-bar-fill--overtime {
  background: linear-gradient(90deg, rgba(190, 24, 93, 0.9), rgba(251, 113, 133, 0.42));
}

.metrics-bar-fill--fragility {
  background: linear-gradient(90deg, rgba(194, 65, 12, 0.92), rgba(251, 146, 60, 0.42));
}

.metrics-fatigue-bands {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(5.75rem, 1fr));
  gap: 0.45rem;
}

.metrics-fatigue-band {
  display: grid;
  gap: 0.12rem;
  padding: 0.55rem 0.6rem;
  border-radius: 0.85rem;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.metrics-fatigue-band strong {
  font-size: 1rem;
  line-height: 1;
}

.metrics-fatigue-band--green {
  background: rgba(22, 163, 74, 0.12);
  color: #166534;
}

.metrics-fatigue-band--amber {
  background: rgba(217, 119, 6, 0.14);
  color: #92400e;
}

.metrics-fatigue-band--red {
  background: rgba(220, 38, 38, 0.13);
  color: #991b1b;
}

.metrics-fatigue-band--critical {
  background: rgba(88, 28, 135, 0.14);
  color: #581c87;
}

.metrics-fatigue-dot {
  width: 0.72rem;
  height: 0.72rem;
  flex: 0 0 auto;
  border-radius: 999px;
}

.metrics-fatigue-dot--green {
  background: #16a34a;
}

.metrics-fatigue-dot--amber {
  background: #d97706;
}

.metrics-fatigue-dot--red {
  background: #dc2626;
}

.metrics-fatigue-dot--critical {
  background: #7e22ce;
}

.metrics-top-list {
  display: grid;
  gap: 0.45rem;
}

.metrics-top-list__title {
  font-size: 0.84rem;
}

.metrics-top-list__rows {
  display: grid;
  gap: 0.35rem;
}

.metrics-top-list__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  color: var(--muted);
  font-size: 0.88rem;
  min-height: 1.15rem;
}

.metrics-top-list__row strong {
  color: var(--ink);
}

.metrics-top-list__row--stacked > span {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.45rem;
}

.metrics-top-list__row--stacked small {
  color: var(--muted);
  font-size: 0.78rem;
}

.metrics-top-list__row--empty {
  color: transparent;
}

.metrics-top-list__row--empty strong {
  color: transparent;
}

.metrics-top-list__empty {
  color: var(--muted);
  font-size: 0.88rem;
}

.metrics-transfer-modal {
  width: min(48rem, calc(100vw - 2rem));
  max-height: min(90dvh, 48rem);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.metrics-transfer-modal__body {
  display: grid;
  gap: 1rem;
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding-right: 0.25rem;
  overscroll-behavior: contain;
}

.metrics-competency-modal {
  width: min(38rem, calc(100vw - 2rem));
}

.metrics-competency-modal__list {
  display: grid;
  gap: 0.7rem;
  max-height: min(22rem, 52vh);
  overflow-y: auto;
  padding-right: 0.25rem;
}

.metrics-competency-modal__row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.45rem 1rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--line);
  border-radius: 0.95rem;
  background: rgba(255, 255, 255, 0.72);
}

.metrics-competency-modal__row span {
  color: var(--muted);
  font-size: 0.86rem;
}

.metrics-overtime-modal {
  width: min(38rem, calc(100vw - 2rem));
}

.metrics-overtime-modal__list {
  display: grid;
  gap: 0.7rem;
  max-height: min(22rem, 52vh);
  overflow-y: auto;
  padding-right: 0.25rem;
}

.metrics-overtime-modal__row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.45rem 1rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--line);
  border-radius: 0.95rem;
  background: rgba(255, 255, 255, 0.72);
}

.metrics-overtime-modal__row span {
  color: var(--muted);
  font-size: 0.86rem;
}

.metrics-transfer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.85rem;
}

.metrics-transfer-actions {
  display: flex;
  justify-content: flex-end;
}

.metrics-transfer-actions--split {
  align-items: center;
  justify-content: space-between;
  gap: 0.85rem;
}

.metrics-transfer-competency-group {
  padding: 0.8rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 255, 255, 0.58);
}

.metrics-transfer-competency-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.85rem;
}

.metrics-transfer-competency-summary {
  margin: 0.15rem 0 0;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 700;
}

.metrics-transfer-competency-toggle {
  min-height: 2.1rem;
  padding: 0 0.75rem;
  font-size: 0.85rem;
}

.metrics-transfer-competency-options {
  padding-top: 0.65rem;
}

.metrics-transfer-competency-option {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  min-height: 2.25rem;
  padding: 0.25rem 0.65rem 0.25rem 0.3rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  color: var(--ink);
  font: inherit;
  cursor: pointer;
  transition:
    background 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease,
    transform 160ms ease;
}

.metrics-transfer-competency-option:hover {
  transform: translateY(-1px);
  border-color: rgba(217, 119, 6, 0.42);
}

.metrics-transfer-competency-option--active {
  border-color: rgba(217, 119, 6, 0.62);
  background: rgba(255, 247, 237, 0.92);
  box-shadow:
    inset 0 0 0 1px rgba(217, 119, 6, 0.22),
    0 8px 18px rgba(217, 119, 6, 0.12);
}

.overtime-eligibility-modal {
  width: min(42rem, 100%);
}

.overtime-eligibility-modal__summary {
  display: grid;
  gap: 0.75rem;
  padding: 0.95rem 1rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 255, 255, 0.72);
}

.overtime-eligibility-modal__summary-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.6rem 1rem;
}

.overtime-eligibility-modal__summary-row strong {
  text-align: right;
}

.overtime-eligibility-modal__list {
  display: grid;
  gap: 0.7rem;
  max-height: min(22rem, 52vh);
  overflow-y: auto;
  padding-right: 0.25rem;
}

.overtime-eligibility-modal__row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.45rem 1rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--line);
  border-radius: 0.95rem;
  background: rgba(255, 255, 255, 0.72);
}

.overtime-eligibility-modal__row span {
  color: var(--muted);
  font-size: 0.86rem;
}

.overtime-my-claims-modal__list {
  display: grid;
  gap: 0.65rem;
  max-height: min(24rem, 52vh);
  overflow-y: auto;
}

.overtime-my-claims-modal__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.8rem;
  border: 1px solid var(--line);
  border-radius: 0.95rem;
  background: rgba(255, 255, 255, 0.72);
}

.overtime-my-claims-modal__row div {
  display: grid;
  gap: 0.2rem;
}

.overtime-my-claims-modal__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.overtime-my-claims-modal__actions .ghost-button {
  padding-inline: 0.75rem;
}

.overtime-my-claims-modal__row span:not(.legend-pill) {
  color: var(--muted);
  font-size: 0.86rem;
}

.overtime-calendar-modal {
  width: 80vw;
  max-width: 80rem;
  height: min(88vh, 54rem);
  max-height: 88vh;
  grid-template-rows: auto minmax(0, 1fr) auto;
  overflow: hidden;
}

.overtime-calendar-modal__scroll {
  overflow: auto;
  padding-bottom: 0.15rem;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

.overtime-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.45rem;
  min-width: 0;
}

.overtime-calendar-weekday {
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.overtime-calendar-day {
  min-height: 8.25rem;
  display: grid;
  align-content: start;
  gap: 0.45rem;
  padding: 0.55rem;
  border: 1px solid var(--line);
  border-radius: 0.85rem;
  background: rgba(255, 255, 255, 0.7);
}

.overtime-calendar-day--empty {
  background: rgba(148, 163, 184, 0.1);
}

.overtime-calendar-day__number {
  color: var(--ink);
  font-size: 0.82rem;
  font-weight: 800;
}

.overtime-calendar-day__postings {
  display: grid;
  gap: 0.35rem;
  min-width: 0;
}

.overtime-calendar-shift-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  justify-self: start;
  max-width: 100%;
  min-width: 0;
  min-height: 1.35rem;
  border-radius: 999px;
  padding: 0.14rem 0.4rem;
  font-size: 0.66rem;
  line-height: 1.1;
  white-space: nowrap;
}

.overtime-calendar-shift-pill span {
  display: block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mutuals-create-action {
  display: flex;
  justify-content: flex-start;
  padding: 0.7rem 0 1rem;
}

.mutual-card {
  gap: 1rem;
}

.mutual-card .legend-pill,
.mutual-application-row .legend-pill {
  align-self: flex-start;
  white-space: nowrap;
}

.mutuals-page {
  padding-bottom: 1.5rem;
}

.mutuals-topbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: 1rem;
}

.mutuals-topbar__year {
  justify-self: end;
  text-align: right;
}

.mutuals-year-pager {
  justify-self: end;
  grid-template-columns: 2.75rem minmax(6rem, auto) 2.75rem;
}

.sub-schedules-month-pager {
  justify-self: end;
}

.metrics-month-pager {
  justify-self: end;
}

.mutuals-section {
  padding: 0 1.5rem 1.4rem;
}

.mutuals-month-nav {
  display: grid;
  gap: 0.6rem;
}

.mutuals-month-nav__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.mutual-card--closed {
  opacity: 0.84;
}

.mutual-card__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
}

.mutual-card__actions .primary-button,
.mutual-card__actions .ghost-button,
.mutual-application-row__actions .primary-button,
.mutual-application-row__actions .ghost-button {
  flex: 0 0 auto;
  align-self: center;
}

.mutual-picker {
  display: grid;
  gap: 0.75rem;
}

.mutual-picker__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.75rem;
}

.mutual-picker__header strong {
  font-size: 0.95rem;
}

.mutual-picker__header span {
  color: var(--muted);
  font-size: 0.82rem;
}

.mutual-picker__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.mutual-date-pill,
.mutual-date-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.55rem 0.72rem;
  border-radius: 999px;
  border: 1px solid rgba(131, 110, 87, 0.14);
  background: rgba(255, 255, 255, 0.78);
  color: var(--ink);
}

.mutual-date-pill {
  cursor: pointer;
  transition:
    border-color 140ms ease,
    background-color 140ms ease,
    box-shadow 140ms ease;
}

.mutual-date-pill:hover {
  border-color: color-mix(in srgb, var(--team-accent) 44%, rgba(131, 110, 87, 0.14));
}

.mutual-date-pill--selected {
  background: color-mix(in srgb, var(--team-accent) 14%, white);
  border-color: color-mix(in srgb, var(--team-accent) 48%, white);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--team-accent) 20%, transparent);
}

.mutual-date-pill strong,
.mutual-date-chip {
  font-size: 0.82rem;
  font-weight: 600;
}

.mutual-date-pill span,
.mutual-date-chip span {
  color: var(--muted);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.mutual-date-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.mutual-date-chip {
  padding: 0.42rem 0.62rem;
  font-size: 0.78rem;
}

.mutual-applications {
  display: grid;
  gap: 0.75rem;
}

.mutual-application-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.85rem;
  padding: 0.8rem 0.9rem;
  border-radius: 1rem;
  border: 1px solid rgba(131, 110, 87, 0.12);
  background: rgba(255, 255, 255, 0.62);
}

.mutual-application-row > div:first-child {
  display: grid;
  gap: 0.2rem;
}

.mutual-application-row span {
  color: var(--muted);
  font-size: 0.82rem;
}

.mutual-application-row__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 0.55rem;
}

.mutual-accepted-grid {
  display: grid;
  gap: 0.9rem;
}

.mutual-accepted-grid > div {
  display: grid;
  gap: 0.45rem;
}

.mutual-modal {
  width: min(42rem, calc(100vw - 2rem));
}

.metrics-transfer-result {
  display: grid;
  gap: 0.9rem;
  padding: 1rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 252, 247, 0.92);
}

.metrics-transfer-result__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.metrics-transfer-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.metrics-transfer-projections {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  gap: 0.75rem;
}

.metrics-transfer-projection {
  display: grid;
  gap: 0.35rem;
  padding: 0.85rem 0.9rem;
  border: 1px solid var(--line);
  border-radius: 0.85rem;
  background: rgba(255, 255, 255, 0.82);
}

.metrics-transfer-projection__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.metrics-transfer-projection p {
  margin: 0;
  color: var(--muted);
  font-size: 0.88rem;
}

.set-builder-pill {
  display: grid;
  gap: 0.1rem;
  justify-items: center;
  min-width: 4.7rem;
  cursor: pointer;
  border: 1px solid transparent;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    opacity 160ms ease,
    filter 160ms ease;
}

.set-builder-pill strong,
.set-builder-pill span {
  line-height: 1;
}

.set-builder-pill span {
  font-size: 0.68rem;
  opacity: 0.78;
}

.set-builder-pill--active {
  border-color: color-mix(in srgb, var(--team-accent) 70%, white);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--team-accent) 18%, transparent);
}

.set-builder-pill--filled {
  border-color: var(--line);
}

.set-builder-pill--overtime {
  border-color: #f97316;
  box-shadow:
    0 0 0 3px rgba(249, 115, 22, 0.28),
    0 0.45rem 1.1rem rgba(249, 115, 22, 0.18);
}

.set-builder-pill--understaffed {
  background: rgba(148, 163, 184, 0.18);
  color: #475569;
  filter: grayscale(0.45);
}

.set-builder-pill--disabled {
  opacity: 0.58;
}

.schedule-scroll-shell {
  display: grid;
  gap: 0;
}

.schedule-wrap {
  position: relative;
  padding: 0 0 0.5rem;
  overflow: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
  border-top: 1px solid var(--line);
}

.schedule-wrap--top-scroll {
  padding: 0;
  overflow-x: auto;
  overflow-y: hidden;
  border-top: 0;
  border-bottom: 1px solid var(--line);
}

.schedule-wrap__scroll-proxy {
  height: 1px;
}

.schedule-wrap--locked {
  cursor: wait;
}

.schedule-wrap--locked .shift-cell-button {
  pointer-events: none;
}

.print-schedule-stack {
  display: none;
}

.print-preview-page {
  min-height: 100vh;
  padding: 1.25rem;
  background: white;
}

.print-preview-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.print-preview-toolbar__actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.print-preview-launcher {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.print-preview-launcher .toolbar-status {
  margin: 0;
  white-space: nowrap;
}

.print-preview-stack {
  display: grid;
  gap: 1rem;
}

.print-schedule-sheet {
  display: block;
}

.print-schedule-sheet__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 0.9rem;
}

.print-schedule-sheet__eyebrow {
  display: block;
  margin-bottom: 0.2rem;
  color: #6b5b4d;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.print-schedule-sheet__title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: 1.25rem;
}

.print-schedule-grid {
  display: grid;
  width: 100%;
}

.print-cell {
  position: static;
  left: auto;
  top: auto;
  box-shadow: none;
}

.print-schedule-grid .shift-cell {
  color: #111827;
  font-weight: 800;
}

.print-schedule-grid .shift-cell--day {
  background: #fde68a;
}

.print-schedule-grid .shift-cell--night {
  background: #bfdbfe;
}

.print-schedule-grid .shift-cell--off {
  background: #e5e7eb;
}

.print-schedule-grid .shift-cell--blank {
  background: #f3f4f6;
}

.print-schedule-grid .shift-cell.legend-pill--amber {
  background: #fbbf24;
}

.print-schedule-grid .shift-cell.legend-pill--teal {
  background: #5eead4;
}

.print-schedule-grid .shift-cell.legend-pill--violet {
  background: #c4b5fd;
}

.print-schedule-grid .shift-cell.legend-pill--rose {
  background: #fda4af;
}

.print-schedule-grid .shift-cell.legend-pill--blue {
  background: #93c5fd;
}

.print-schedule-grid .shift-cell.legend-pill--lime {
  background: #bef264;
}

.print-schedule-grid .shift-cell.legend-pill--orange {
  background: #fdba74;
}

.print-schedule-grid .shift-cell.legend-pill--slate {
  background: #cbd5e1;
}

.schedule-autosave-modal {
  position: fixed;
  right: max(1rem, env(safe-area-inset-right));
  bottom: max(1rem, env(safe-area-inset-bottom));
  z-index: 29;
  display: flex;
  align-items: center;
  gap: 0.85rem;
  max-width: min(22rem, calc(100vw - 2rem));
  padding: 0.75rem 0.85rem;
  border: 1px solid color-mix(in srgb, var(--team-accent, #f97316) 30%, white);
  border-radius: 1rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 248, 238, 0.96)),
    var(--surface);
  box-shadow: 0 18px 42px rgba(23, 20, 17, 0.18);
  pointer-events: auto;
}

.schedule-autosave-modal > div {
  display: grid;
  gap: 0.1rem;
  min-width: 0;
}

.schedule-autosave-modal strong {
  color: var(--ink);
  font-size: 0.78rem;
}

.schedule-autosave-modal span {
  color: var(--muted);
  font-size: 0.7rem;
}

.schedule-autosave-modal--saving {
  border-color: color-mix(in srgb, var(--team-accent, #f97316) 55%, white);
}

.schedule-autosave-modal--saved {
  border-color: rgba(22, 163, 74, 0.35);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(240, 253, 244, 0.96)),
    var(--surface);
}

.schedule-autosave-modal--error {
  border-color: rgba(185, 28, 28, 0.3);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(254, 242, 242, 0.96)),
    var(--surface);
}

.schedule-autosave-modal .ghost-button {
  min-height: 2rem;
  padding: 0.35rem 0.7rem;
  white-space: nowrap;
}

.assignment-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: grid;
  place-items: center;
  padding: 1.5rem;
  background: rgba(23, 20, 17, 0.34);
  backdrop-filter: blur(8px);
}

.assignment-modal {
  width: min(40rem, 100%);
  display: grid;
  gap: 1rem;
  padding: 1.25rem;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 1.2rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 249, 240, 0.92)),
    var(--surface);
  box-shadow: 0 24px 48px rgba(23, 20, 17, 0.2);
}

.assignment-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.assignment-modal__title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: 1.15rem;
  letter-spacing: -0.03em;
}

.assignment-modal__context {
  margin: 0.2rem 0 0;
  color: var(--muted);
  font-size: 0.88rem;
}

.assignment-modal__group {
  display: grid;
  gap: 0.45rem;
}

.assignment-modal__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.assignment-modal__options {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.modal-form-grid {
  display: grid;
  gap: 0.85rem;
}

.temporary-loan-modal {
  width: min(48rem, 100%);
}

.temporary-loan-date-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.35rem;
  max-height: min(18rem, 42vh);
  overflow: auto;
  padding: 0.15rem;
}

.temporary-loan-date {
  display: grid;
  gap: 0.1rem;
  place-items: center;
  min-height: 3rem;
  border: 1px solid var(--line);
  border-radius: 0.75rem;
  background: rgba(255, 255, 255, 0.72);
  color: var(--ink);
  font: inherit;
  cursor: pointer;
}

.temporary-loan-date span {
  color: var(--muted);
  font-size: 0.68rem;
  text-transform: uppercase;
}

.temporary-loan-date strong {
  font-size: 0.85rem;
}

.temporary-loan-date:hover:not(:disabled),
.temporary-loan-date--selected {
  border-color: color-mix(in srgb, var(--team-accent, #f97316) 55%, white);
  background: color-mix(in srgb, var(--team-accent, #f97316) 16%, white);
}

.temporary-loan-date:disabled {
  cursor: not-allowed;
  opacity: 0.38;
}

.shift-order-modal {
  width: min(34rem, 100%);
}

.shift-order-list {
  display: grid;
  gap: 0.45rem;
  max-height: min(30rem, 58vh);
  overflow: auto;
  padding: 0.15rem;
}

.shift-order-row {
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr);
  align-items: center;
  gap: 0.75rem;
  padding: 0.7rem 0.85rem;
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  background: rgba(255, 255, 255, 0.76);
  cursor: grab;
}

.shift-order-row:active {
  cursor: grabbing;
}

.shift-order-row--dragging {
  border-color: color-mix(in srgb, var(--team-accent, #f97316) 48%, white);
  background: color-mix(in srgb, var(--team-accent, #f97316) 13%, white);
}

.shift-order-row__handle {
  display: inline-flex;
  justify-content: center;
  color: var(--muted);
  font-weight: 700;
  letter-spacing: -0.08em;
}

.shift-order-row div {
  display: grid;
  gap: 0.15rem;
  min-width: 0;
}

.shift-order-row strong {
  font-size: 0.85rem;
}

.shift-order-row span:not(.shift-order-row__handle) {
  color: var(--muted);
  font-size: 0.74rem;
}

.assignment-modal__note-input {
  width: 100%;
  min-height: 5.5rem;
  resize: vertical;
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  background: rgba(255, 255, 255, 0.84);
  padding: 0.8rem 0.9rem;
  font: inherit;
  color: var(--ink);
}

.assignment-modal__note-input:focus {
  outline: 2px solid color-mix(in srgb, var(--team-accent, #f97316) 35%, white);
  outline-offset: 2px;
}

.assignment-modal__danger-zone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.85rem;
  border: 1px solid rgba(185, 28, 28, 0.22);
  border-radius: 0.95rem;
  background: rgba(254, 242, 242, 0.74);
}

.assignment-modal__danger-zone > div:first-child {
  display: grid;
  gap: 0.2rem;
}

.assignment-modal__danger-zone strong {
  font-size: 0.7rem;
  color: #991b1b;
}

.assignment-modal__danger-zone span {
  color: var(--muted);
  font-size: 0.82rem;
}

.assignment-modal__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.65rem;
}

.personnel-cleanup-modal {
  width: min(44rem, 100%);
}

.personnel-cleanup-modal__list {
  display: grid;
  gap: 0.65rem;
  max-height: min(24rem, 52vh);
  overflow-y: auto;
  padding: 0.1rem;
}

.personnel-cleanup-modal__row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 1rem;
  padding: 0.8rem 0.9rem;
  border: 1px solid var(--line);
  border-radius: 0.95rem;
  background: rgba(255, 255, 255, 0.72);
}

.personnel-cleanup-modal__row div {
  display: grid;
  gap: 0.2rem;
  min-width: 0;
}

.personnel-cleanup-modal__row div:last-child {
  justify-items: end;
  text-align: right;
}

.personnel-cleanup-modal__row strong {
  font-size: 0.78rem;
}

.personnel-cleanup-modal__row span {
  color: var(--muted);
  font-size: 0.78rem;
}

.set-completion-modal__list {
  display: grid;
  gap: 0.65rem;
  max-height: min(22rem, 52vh);
  overflow-y: auto;
}

.set-completion-modal__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.8rem;
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  background: rgba(255, 255, 255, 0.62);
}

.set-completion-modal__row div {
  display: grid;
  gap: 0.15rem;
}

.set-completion-modal__row span,
.set-completion-modal__row small {
  color: var(--muted);
}

.set-completion-modal__row small {
  text-align: right;
}

.personnel-table-wrap {
  overflow: auto;
  border-top: 1px solid var(--line);
}

.time-code-sections {
  display: grid;
  gap: 1.35rem;
}

.time-code-section {
  display: grid;
  gap: 0.75rem;
}

.time-code-section .metrics-section__title-group p {
  margin: 0;
  color: var(--muted);
  font-size: 0.82rem;
}

.personnel-table {
  width: 100%;
  min-width: 58rem;
  border-collapse: collapse;
}

.personnel-table th,
.personnel-table td {
  padding: 0.78rem 0.72rem;
  text-align: left;
  border-bottom: 1px solid var(--line);
  vertical-align: top;
  background: rgba(255, 252, 247, 0.75);
}

.personnel-table th {
  position: sticky;
  top: 0;
  z-index: 2;
  background: rgba(250, 243, 234, 0.96);
  color: var(--muted);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.personnel-table th.column-name,
.personnel-table td.column-name {
  min-width: 9rem;
  width: 9rem;
}

.personnel-table th.column-shift,
.personnel-table td.column-shift {
  min-width: 7.1rem;
  width: 7.1rem;
  padding-left: 0.82rem;
  padding-right: 0.82rem;
}

.personnel-table th.column-email,
.personnel-table td.column-email {
  min-width: 15.5rem;
}

.personnel-table th.column-competencies,
.personnel-table td.column-competencies {
  min-width: 16rem;
}

.personnel-table th.column-actions,
.personnel-table td.column-actions {
  width: 1%;
  white-space: nowrap;
}

.table-group-row td {
  padding: 0.5rem 0.72rem;
  background: rgba(245, 236, 223, 0.88);
  color: var(--muted);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.invite-builder {
  display: grid;
  gap: 1rem;
  margin-block: 1rem 1.25rem;
  padding: 1rem 1.1rem;
  border: 1px solid var(--line);
  border-radius: 1.1rem;
  background: rgba(255, 250, 244, 0.82);
}

.invite-builder__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.invite-builder__header p {
  margin: 0.35rem 0 0;
  color: var(--muted);
  font-size: 0.92rem;
}

.invite-builder__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.9rem 1rem;
}

.invite-builder__email,
.invite-builder__link {
  grid-column: 1 / -1;
}

.invite-builder__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.table-row--dirty td {
  background: rgba(255, 248, 235, 0.92);
}

.table-row--draft td {
  background: rgba(239, 246, 255, 0.92);
}

.table-row--invalid td {
  background: rgba(255, 240, 240, 0.92);
}

.table-row--selected td {
  background: rgba(247, 242, 230, 0.96);
}

.subschedule-status-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.88rem;
}

.subschedule-builder-section {
  margin-top: 1.5rem;
  padding-top: 0.65rem;
}

.subschedule-builder-section > .workspace-toolbar .toolbar-actions {
  gap: 0.45rem;
  padding: 0.2rem;
}

.subschedule-builder-toolbar {
  grid-template-columns: minmax(0, 1fr);
  row-gap: 0.9rem;
}

.subschedule-builder-toolbar .toolbar-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.subschedule-grid-wrap {
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: 1.25rem;
  background: rgba(255, 252, 247, 0.72);
}

.subschedule-grid {
  display: grid;
  align-items: stretch;
  width: max-content;
  min-width: 100%;
}

.subschedule-add-row {
  min-height: 3rem;
}

.subschedule-add-row__button {
  width: 100%;
  min-height: 2.4rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  border: 1px dashed color-mix(in srgb, var(--team-accent, #f97316) 48%, var(--line));
  border-radius: 0.85rem;
  background: color-mix(in srgb, var(--team-accent, #f97316) 8%, white);
  color: var(--ink);
  font-weight: 800;
  cursor: pointer;
}

.subschedule-add-row__button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.subschedule-add-row__button span {
  display: inline-grid;
  place-items: center;
  width: 1.15rem;
  height: 1.15rem;
  border-radius: 999px;
  background: var(--team-accent, #f97316);
  color: #fff;
  line-height: 1;
}

.subschedule-add-row__cell {
  min-height: 3rem;
  opacity: 0.64;
}

.shift-cell--projected {
  box-shadow: inset 0 0 0 1px var(--line-strong);
}

.table-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.table-pills--editable .legend-pill {
  cursor: pointer;
}

.legend-pill--selected {
  box-shadow: inset 0 0 0 2px var(--line-strong);
}

.legend-pill--muted {
  opacity: 0.42;
}

.schedule-grid {
  --schedule-name-column-width: 7.75rem;
  --schedule-day-column-width: clamp(2.2rem, calc((100vw - 18rem) / 31), 2.35rem);
  display: grid;
  align-items: stretch;
  width: max-content;
  min-width: 100%;
}

.schedule-grid__header,
.schedule-grid-row {
  display: grid;
  align-items: stretch;
}

.schedule-grid__rows {
  position: relative;
}

.employee-header,
.day-header,
.employee-cell,
.shift-cell,
.empty-state {
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: rgba(255, 252, 247, 0.72);
}

.employee-header,
.day-header {
  position: sticky;
  top: 0;
  z-index: 4;
  min-height: auto;
}

.employee-header {
  display: grid;
  gap: 0.35rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--team-accent) 22%, white), rgba(255, 253, 249, 0.96));
}

.employee-header span {
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.employee-header strong {
  font-family: var(--font-display), sans-serif;
  font-size: 0.92rem;
}

.day-header {
  display: grid;
  justify-items: center;
  gap: 0.1rem;
  padding: 0.35rem 0.05rem;
  text-align: center;
  cursor: pointer;
  transition:
    background-color 160ms ease,
    box-shadow 160ms ease,
    color 160ms ease;
}

.day-header span {
  color: var(--muted);
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.day-header strong {
  font-family: var(--font-display), sans-serif;
  font-size: 0.8rem;
}

.day-header--weekend {
  background: rgba(252, 246, 239, 0.94);
}

.day-header--set {
  box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--team-accent) 48%, transparent);
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.94), rgba(249, 242, 232, 0.98));
}

.day-header--set.day-header--weekend {
  background: linear-gradient(180deg, rgba(252, 246, 239, 0.98), rgba(248, 238, 224, 0.96));
}

.day-header--completed {
  background: linear-gradient(180deg, rgba(220, 252, 231, 0.98), rgba(187, 247, 208, 0.95));
  box-shadow: inset 0 -2px 0 rgba(21, 128, 61, 0.28);
}

.day-header--completed.day-header--set {
  background: linear-gradient(180deg, rgba(220, 252, 231, 0.98), rgba(187, 247, 208, 0.95));
  box-shadow: inset 0 -2px 0 rgba(21, 128, 61, 0.28);
}

.day-header--completed span,
.day-header--completed strong {
  color: #166534;
}

.day-header--completed.day-header--weekend {
  background: linear-gradient(180deg, rgba(209, 250, 229, 0.98), rgba(167, 243, 208, 0.94));
}

.day-header--completed.day-header--set.day-header--weekend {
  background: linear-gradient(180deg, rgba(209, 250, 229, 0.98), rgba(167, 243, 208, 0.94));
}

.day-header--set-anchor {
  box-shadow:
    inset 0 0 0 2px color-mix(in srgb, var(--team-accent) 75%, white),
    inset 0 -2px 0 color-mix(in srgb, var(--team-accent) 60%, transparent);
}

.day-header--completed.day-header--set-anchor {
  box-shadow:
    inset 0 0 0 2px rgba(21, 128, 61, 0.34),
    inset 0 -2px 0 rgba(21, 128, 61, 0.28);
}

.day-header--missing {
  background: linear-gradient(180deg, rgba(255, 237, 213, 0.98), rgba(254, 215, 170, 0.98));
  box-shadow:
    inset 0 0 0 2px rgba(249, 115, 22, 0.5),
    inset 0 -3px 0 rgba(249, 115, 22, 0.62);
}

.day-header--missing span,
.day-header--missing strong {
  color: #9a3412;
}

.sticky-column {
  position: sticky;
  left: 0;
  z-index: 3;
  box-shadow: 1px 0 0 rgba(131, 110, 87, 0.08);
}

.employee-header.sticky-column,
.employee-cell.sticky-column,
.empty-state.sticky-column {
  left: 0;
}

.employee-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.45rem;
  min-height: 3.15rem;
  padding: 0.4rem 0.45rem 0.4rem 0.65rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(250, 242, 230, 0.9));
}

.employee-cell__main {
  display: grid;
  align-content: center;
  gap: 0.2rem;
  min-width: 0;
  flex: 1 1 auto;
}

.employee-cell strong {
  font-size: 1.08rem;
  line-height: 1.1;
}

.employee-cell strong,
.employee-cell span {
  min-width: 0;
}

.employee-name-compact {
  display: none;
}

.employee-cell span,
.employee-cell small {
  color: var(--muted);
  font-size: 0.7rem;
  line-height: 1.1;
}

.employee-cell--selected {
  outline: 2px solid var(--team-accent);
  outline-offset: -2px;
  z-index: 4;
}

.shift-cell {
  position: relative;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 0;
  min-height: 3.15rem;
  padding: 0;
  content-visibility: auto;
  contain-intrinsic-size: 58px;
  overflow: hidden;
}

.shift-cell--range {
  outline: 2px solid color-mix(in srgb, var(--team-accent) 55%, white);
  outline-offset: -2px;
}

.shift-cell--selected {
  outline: 2px solid var(--team-accent);
  outline-offset: -2px;
  z-index: 1;
}

.shift-cell--coded {
  box-shadow: inset 0 0 0 1px var(--line);
}

.shift-cell--has-note {
  box-shadow: inset 0 0 0 1px var(--line);
}

.shift-cell--locked {
  box-shadow:
    inset 0 0 0 999px var(--line),
    inset 0 0 0 1px var(--line);
}

.shift-cell--locked-coded {
  box-shadow:
    inset 0 0 0 999px rgba(255, 255, 255, 0.08),
    inset 0 0 0 1px var(--line);
}

.shift-cell--missing-column {
  box-shadow:
    inset 0 0 0 999px rgba(251, 146, 60, 0.11),
    inset 0 0 0 1px rgba(249, 115, 22, 0.24);
}

.shift-cell--coverage-focus {
  box-shadow:
    inset 0 0 0 2px rgba(248, 113, 113, 0.45),
    inset 0 0 0 999px rgba(255, 255, 255, 0.03);
}

.shift-cell__note-indicator {
  position: absolute;
  top: 0.34rem;
  right: 0.34rem;
  width: 0.42rem;
  height: 0.42rem;
  border-radius: 999px;
  background: rgba(23, 20, 17, 0.72);
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.7);
}

.shift-cell--day {
  background: linear-gradient(180deg, rgba(255, 250, 236, 0.98), rgba(255, 244, 220, 0.96));
}

.shift-cell--night {
  background: linear-gradient(180deg, rgba(237, 244, 255, 0.94), rgba(224, 234, 255, 0.98));
}

.shift-cell--off {
  background: linear-gradient(180deg, rgba(243, 239, 234, 0.94), rgba(236, 231, 225, 0.96));
}

.shift-cell--weekend {
  box-shadow: inset 0 0 0 999px rgba(255, 255, 255, 0.08);
}

.shift-cell.legend-pill--amber {
  background: linear-gradient(180deg, rgba(251, 191, 36, 0.22), rgba(251, 191, 36, 0.15));
}

.shift-cell.legend-pill--teal {
  background: linear-gradient(180deg, rgba(20, 184, 166, 0.21), rgba(20, 184, 166, 0.14));
}

.shift-cell.legend-pill--violet {
  background: linear-gradient(180deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.13));
}

.shift-cell.legend-pill--rose {
  background: linear-gradient(180deg, rgba(244, 63, 94, 0.19), rgba(244, 63, 94, 0.12));
}

.shift-cell.legend-pill--blue {
  background: linear-gradient(180deg, rgba(37, 99, 235, 0.19), rgba(37, 99, 235, 0.12));
}

.shift-cell.legend-pill--lime {
  background: linear-gradient(180deg, rgba(132, 204, 22, 0.22), rgba(132, 204, 22, 0.14));
}

.shift-cell.legend-pill--orange {
  background: linear-gradient(180deg, rgba(249, 115, 22, 0.21), rgba(249, 115, 22, 0.14));
}

.shift-cell.legend-pill--slate {
  background: linear-gradient(180deg, rgba(100, 116, 139, 0.2), rgba(100, 116, 139, 0.13));
}

.shift-cell-button {
  position: absolute;
  inset: 0;
  appearance: none;
  -webkit-appearance: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100%;
  padding: 0.22rem 0.08rem;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 0.74rem;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  cursor: pointer;
}

.shift-cell-button.legend-pill--amber,
.shift-cell-button.legend-pill--teal,
.shift-cell-button.legend-pill--violet,
.shift-cell-button.legend-pill--rose,
.shift-cell-button.legend-pill--blue,
.shift-cell-button.legend-pill--lime,
.shift-cell-button.legend-pill--orange,
.shift-cell-button.legend-pill--slate {
  border-color: transparent;
  background: transparent;
}

.shift-cell-button:focus {
  outline: none;
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--team-accent) 16%, transparent);
}

.shift-cell-button:disabled {
  cursor: default;
  opacity: 1;
  -webkit-text-fill-color: currentColor;
}

.table-input,
.table-select {
  width: 100%;
  min-height: 2.35rem;
  padding: 0.42rem 0.55rem;
  border: 1px solid var(--line);
  border-radius: 0.85rem;
  background: rgba(255, 255, 255, 0.85);
  color: var(--ink);
}

.table-input:focus,
.table-select:focus {
  outline: none;
  border-color: color-mix(in srgb, var(--team-accent) 65%, white);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--team-accent) 18%, transparent);
}

.table-input-stack {
  display: grid;
  gap: 0.32rem;
  align-items: start;
}

.table-code {
  display: inline-flex;
  padding: 0.35rem 0.55rem;
  border-radius: 0.7rem;
  background: var(--line);
  font-size: 0.78rem;
}

.table-meta {
  display: grid;
  gap: 0.18rem;
}

.table-meta strong {
  font-size: 0.84rem;
}

.table-meta span {
  font-size: 0.74rem;
  color: var(--muted);
}

.table-actions-cell {
  width: 1%;
  white-space: nowrap;
  display: grid;
  gap: 0.45rem;
  justify-items: end;
}

.table-action {
  min-height: 2rem;
  padding: 0 0.8rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.7);
  color: var(--ink);
  cursor: pointer;
}

.table-action--danger {
  color: #991b1b;
}

.table-action--confirm {
  color: #166534;
}

.table-actions-inline {
  display: inline-flex;
  gap: 0.45rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.row-issue {
  margin: 0;
  color: #b91c1c;
  font-size: 0.74rem;
  white-space: normal;
  text-align: left;
}

.import-preview {
  display: grid;
  gap: 0.8rem;
  margin: 0 1.5rem 1rem;
  padding: 1rem 1.1rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  background: rgba(255, 252, 247, 0.84);
}

.import-preview__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.import-preview__header p {
  margin: 0.18rem 0 0;
  color: var(--muted);
}

.import-preview__rows {
  display: grid;
  gap: 0.45rem;
}

.import-preview__row {
  display: grid;
  grid-template-columns: minmax(10rem, 1.4fr) minmax(5rem, 0.7fr) minmax(6rem, 0.8fr) minmax(0, 1fr);
  gap: 0.75rem;
  padding: 0.7rem 0.8rem;
  border-radius: 0.85rem;
  background: rgba(255, 255, 255, 0.72);
  font-size: 0.88rem;
}

.overtime-list {
  display: grid;
  gap: 1rem;
  padding: 0 1.5rem 1.5rem;
}

.overtime-list--loading {
  align-content: start;
}

.overtime-group {
  display: grid;
  gap: 0.85rem;
}

.overtime-group__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: 0.2rem;
  border-bottom: 1px solid var(--line);
}

.overtime-group__meta {
  color: var(--muted);
  font-size: 0.86rem;
  font-weight: 600;
}

.overtime-group__cards {
  display: grid;
  gap: 0.85rem;
}

.overtime-card {
  display: grid;
  gap: 0.9rem;
  padding: 1rem 1.1rem;
  border: 1px solid var(--line);
  border-radius: 1.1rem;
  background: rgba(255, 252, 247, 0.85);
}

.overtime-card--loading {
  pointer-events: none;
}

.overtime-card-top,
.overtime-card-actions,
.overtime-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.9rem;
  flex-wrap: wrap;
}

.overtime-card-team {
  margin: 0 0 0.2rem;
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.overtime-card-title {
  margin: 0;
  font-family: var(--font-display), sans-serif;
  font-size: 1.2rem;
  line-height: 1;
}

.overtime-card-meta,
.overtime-card-hint {
  color: var(--muted);
  font-size: 0.9rem;
}

.overtime-card-actions {
  align-items: flex-start;
}

.overtime-card-actions__buttons {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.55rem;
  margin-left: auto;
}

.overtime-card-actions__buttons .primary-button,
.overtime-card-actions__buttons .ghost-button {
  width: auto;
}

.loading-stack {
  display: grid;
  gap: 0.55rem;
}

.loading-block {
  display: inline-block;
  border-radius: 999px;
  background:
    linear-gradient(90deg, rgba(148, 163, 184, 0.16), rgba(255, 255, 255, 0.9), rgba(148, 163, 184, 0.16));
  background-size: 220% 100%;
  animation: loading-shimmer 1.25s ease-in-out infinite;
}

.loading-block--sm {
  width: 6rem;
  height: 0.8rem;
}

.loading-block--md {
  width: 8rem;
  height: 0.95rem;
}

.loading-block--lg {
  width: min(18rem, 70%);
  height: 1.1rem;
}

.loading-block--pill {
  width: 5.75rem;
  height: 2rem;
}

.loading-block--button {
  width: 8.5rem;
  height: 2.75rem;
}

@keyframes loading-shimmer {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: -100% 0;
  }
}

.overtime-option-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.overtime-option-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  border: 1px solid transparent;
  cursor: pointer;
}

.overtime-option-pill strong,
.overtime-option-pill span {
  line-height: 1;
}

.overtime-option-pill span {
  color: inherit;
  font-size: 0.72rem;
  opacity: 0.78;
}

.overtime-option-pill--active {
  box-shadow: inset 0 0 0 2px var(--line-strong);
}

.empty-state {
  display: grid;
  align-content: center;
  gap: 0.25rem;
  padding: 1.25rem;
  min-height: 7rem;
}

.empty-state span {
  color: var(--muted);
}

.empty-state__action {
  justify-self: start;
  margin-top: 0.35rem;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

@media (max-width: 1100px) {
  .landing-hero,
  .landing-columns,
  .landing-role-grid,
  .profile-grid {
    grid-template-columns: 1fr;
  }

  .landing-hero {
    min-height: auto;
  }

  .shell {
    padding: 0;
  }

  .workspace-frame {
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    border-radius: 0;
    grid-template-columns: 13rem minmax(0, 1fr);
  }

  .workspace-frame--collapsed {
    grid-template-columns: 4.75rem minmax(0, 1fr);
  }

  .planner-actions {
    justify-content: flex-start;
  }

  .workspace-sidebar {
    border-right: 1px solid var(--line);
    border-bottom: 0;
    gap: 1.1rem;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
  }

  .workspace-admin-scope__fields {
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .workspace-session {
    margin-top: auto;
  }

  .workspace-brand-row {
    align-items: center;
  }

  .workspace-nav {
    grid-auto-flow: row;
    grid-auto-columns: auto;
    overflow: visible;
    padding-bottom: 0;
  }

  .workspace-sidebar--collapsed {
    width: 4.75rem;
    gap: 0.55rem;
    padding-block: 0.7rem;
  }

  .panel-heading,
  .workspace-toolbar {
    grid-template-columns: 1fr;
  }

  .workspace-toolbar--scheduler {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .workspace-toolbar--overtime {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .summary-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .workspace-copy {
    border-left: 0;
    border-top: 1px solid var(--line);
    padding-left: 0;
    padding-right: 0;
  }

  .workspace-copy--full {
    border-top: 0;
  }

  .workspace-sidebar--collapsed .workspace-brand strong,
  .workspace-sidebar--collapsed .workspace-nav-link strong {
    display: inline;
  }

  .workspace-sidebar--collapsed .workspace-nav-link {
    justify-content: center;
    padding-inline: 0.5rem;
  }

  .workspace-sidebar--collapsed .workspace-brand-row {
    min-height: 0;
  }

  .workspace-sidebar--collapsed .workspace-nav {
    padding-bottom: 0;
  }

  .workspace-sidebar--collapsed .workspace-session {
    padding-block: 0;
    gap: 0.35rem;
  }
}

.workspace-sidebar--collapsed .workspace-brand span,
.workspace-sidebar--collapsed .workspace-brand strong,
.workspace-sidebar--collapsed .workspace-nav-link strong,
.workspace-sidebar--collapsed .workspace-notifications__badge,
.workspace-sidebar--collapsed .workspace-session__meta,
.workspace-sidebar--collapsed .workspace-admin-scope {
  display: none;
}

.workspace-sidebar--collapsed .brand-lockup__logo {
  display: none;
}

.workspace-sidebar--collapsed .workspace-brand {
  display: none;
  padding: 0;
}

.workspace-sidebar--collapsed .workspace-nav-link {
  justify-content: center;
  padding-inline: 0.5rem;
}

.workspace-sidebar--collapsed .workspace-brand-row {
  justify-content: center;
}

.workspace-sidebar--collapsed .workspace-session {
  justify-items: center;
  padding-inline: 0.35rem;
  gap: 0.5rem;
}

.workspace-sidebar--collapsed .workspace-session__signout {
  width: 2.9rem;
  min-height: 2.9rem;
  padding-inline: 0;
  border-radius: 0.95rem;
  overflow: hidden;
  white-space: nowrap;
  text-indent: -9999px;
  position: relative;
}

.workspace-sidebar--collapsed .workspace-session__signout::before {
  content: "↦";
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  text-indent: 0;
  font-size: 1rem;
}

@media (max-width: 720px) {
  .workspace-content {
    padding: 0.8rem;
  }

  .workspace-admin-scope__fields {
    grid-template-columns: 1fr;
  }

  .panel-heading {
    padding: 1rem 1rem 0.8rem;
  }

  .invite-builder__header {
    flex-direction: column;
  }

  .invite-builder__grid {
    grid-template-columns: 1fr;
  }

  .workspace-toolbar,
  .workspace-toolbar--personnel,
  .workspace-toolbar--actions,
  .workspace-toolbar--personnel-page,
  .workspace-toolbar--overtime,
  .workspace-toolbar--metrics,
  .workspace-toolbar--scheduler {
    grid-template-columns: 1fr;
    padding: 0 1rem 1rem;
    align-items: stretch;
  }

  .overtime-calendar-grid {
    grid-template-columns: repeat(7, minmax(6.75rem, 1fr));
    min-width: 49rem;
  }

  .workspace-copy,
  .toolbar-status-wrap {
    justify-content: flex-start;
    padding-inline: 0;
  }

  .personnel-toolbar-actions {
    justify-content: flex-start;
  }

  .personnel-actions-menu__panel {
    right: auto;
    left: 0;
  }

  .metrics-grid,
  .mutuals-section {
    padding-inline: 1rem;
  }

  .metrics-page-title {
    width: 100%;
    justify-content: space-between;
  }

  .metrics-section__header,
  .metrics-card__header,
  .metrics-transfer-result__header,
  .mutual-picker__header,
  .print-preview-toolbar,
  .print-schedule-sheet__header {
    flex-direction: column;
    align-items: flex-start;
  }

  .metrics-section__controls,
  .metrics-section__title-group,
  .metrics-window-toggle,
  .mutuals-month-nav__buttons,
  .mutual-card__actions,
  .mutual-application-row__actions,
  .print-preview-toolbar__actions,
  .print-preview-launcher {
    width: 100%;
    justify-content: flex-start;
  }

  .metrics-field-inline {
    min-width: 0;
    width: 100%;
  }

  .mutuals-page .metrics-card {
    padding: 0.95rem 1rem;
  }

  .mutuals-page .field {
    min-width: 0;
  }

  .mutuals-month-nav,
  .mutual-picker,
  .mutual-applications,
  .mutual-accepted-grid {
    min-width: 0;
  }

  .mutuals-topbar {
    grid-template-columns: 1fr;
  }

  .mutuals-topbar__year {
    justify-self: stretch;
    text-align: left;
  }

  .mutual-date-summary,
  .mutual-picker__grid {
    gap: 0.45rem;
  }

  .mutual-application-row {
    flex-direction: column;
    align-items: stretch;
  }

  .mutual-application-row__actions {
    width: 100%;
    justify-content: flex-start;
  }

  .mutual-card__actions {
    width: 100%;
    justify-content: flex-start;
  }

  .mutual-card__actions .primary-button,
  .mutual-card__actions .ghost-button,
  .mutual-application-row__actions .primary-button,
  .mutual-application-row__actions .ghost-button {
    width: auto;
  }

  .metrics-team-list {
    grid-template-columns: 1fr;
  }

  .overtime-list {
    padding-inline: 1rem;
  }

  .overtime-card {
    padding: 0.9rem 1rem;
  }

  .overtime-card-top,
  .overtime-card-actions,
  .overtime-card-meta {
    align-items: flex-start;
  }

  .overtime-card-actions {
    flex-direction: column;
  }

  .overtime-card-actions__buttons {
    width: 100%;
    align-items: stretch;
    margin-left: 0;
  }

  .overtime-card-actions__buttons .primary-button,
  .overtime-card-actions__buttons .ghost-button {
    width: 100%;
  }

  .overtime-card-hint {
    width: 100%;
  }

  .metrics-card__stats {
    justify-items: start;
    text-align: left;
  }

  .metrics-bar-row__label,
  .metrics-transfer-projection__label {
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .metrics-transfer-grid,
  .metrics-transfer-projections,
  .mutual-accepted-grid {
    grid-template-columns: 1fr;
  }

  .metrics-transfer-actions,
  .metrics-transfer-actions--split {
    width: 100%;
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .mutuals-create-action {
    width: 100%;
  }

  .mutual-application-row {
    align-items: flex-start;
  }

  .mutual-modal,
  .metrics-transfer-modal,
  .assignment-modal {
    width: min(100%, calc(100vw - 1.25rem));
  }

  .personnel-table-wrap,
  .schedule-wrap {
    -webkit-overflow-scrolling: touch;
  }

  .schedule-wrap--top-scroll {
    display: none;
  }

  .landing-hero,
  .landing-band,
  .landing-detail,
  .landing-cta {
    padding-inline: 1rem;
  }

  .landing-blueprint__rail,
  .landing-blueprint__roles {
    grid-template-columns: 1fr;
    justify-content: flex-start;
  }

  .landing-blueprint__roles {
    display: grid;
  }

  .auth-shell {
    padding: 1rem;
  }

  .auth-home {
    padding: 1rem;
  }

  .auth-home__panel {
    padding: 1.2rem;
  }

  .auth-home__actions {
    grid-template-columns: 1fr;
  }

  .auth-panel {
    padding: 1.2rem;
  }

  .auth-name-grid {
    grid-template-columns: 1fr;
  }

  .planner-actions {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
  }

  .planner-actions__row {
    width: 100%;
  }

  .planner-actions__row--month,
  .planner-actions__row--nav,
  .planner-actions__row--save {
    justify-content: flex-start;
  }

  .schedule-heading-month {
    width: 100%;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
  }

  .mutuals-year-pager {
    justify-self: stretch;
  }

  .sub-schedules-month-pager {
    justify-self: stretch;
  }

  .metrics-month-pager {
    justify-self: stretch;
  }

  .schedule-heading-month__label {
    padding-inline: 0.65rem;
    font-size: clamp(1.45rem, 8vw, 2rem);
  }

  .planner-actions--schedule {
    align-items: flex-start;
  }

  .schedule-grid {
    --schedule-name-column-width: 6.15rem;
    --schedule-day-column-width: 1.92rem;
  }

  .employee-header {
    padding-inline: 0.55rem;
  }

  .employee-cell {
    min-height: 2.95rem;
    padding: 0.34rem 0.28rem 0.34rem 0.45rem;
  }

  .employee-cell {
    gap: 0.3rem;
  }

  .employee-cell strong {
    font-size: 0.86rem;
  }

  .employee-cell span,
  .employee-cell small {
    font-size: 0.7rem;
  }

  .employee-name-full {
    display: none;
  }

  .employee-name-compact {
    display: inline;
  }

  .shift-cell {
    min-height: 2.95rem;
  }

  .shift-cell-button {
    font-size: 0.68rem;
  }

  .profile-grid {
    padding-inline: 1rem;
  }

  .profile-section {
    padding-inline: 1rem;
  }

  .planner-topline {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .summary-row {
    grid-template-columns: 1fr;
  }

  .field select,
  .field input {
    min-height: 2.8rem;
  }

  .assignment-modal__header,
  .import-preview__header,
  .overtime-group__header {
    flex-direction: column;
    align-items: flex-start;
  }

  .assignment-modal-backdrop {
    padding: 0.6rem;
  }

  .schedule-autosave-modal {
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    left: max(0.75rem, env(safe-area-inset-left));
    max-width: none;
    justify-content: space-between;
  }

  .assignment-modal {
    max-height: min(90vh, 42rem);
    overflow: auto;
  }

  .metrics-transfer-modal {
    max-height: min(90dvh, 42rem);
    overflow: hidden;
  }

  .metrics-transfer-modal__body {
    padding-right: 0;
  }

  .overtime-option-pills {
    gap: 0.45rem;
  }

  .import-preview__row {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar--collapsed {
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
  }

  .workspace-sidebar--collapsed .workspace-brand-row {
    gap: 0;
  }

  .workspace-sidebar--collapsed .sidebar-toggle,
  .workspace-sidebar--collapsed .workspace-nav-icon,
  .workspace-sidebar--collapsed .workspace-session__signout {
    width: 2.45rem;
    height: 2.45rem;
    min-height: 2.45rem;
    border-radius: 0.8rem;
  }

  .workspace-sidebar--collapsed .workspace-nav-link {
    padding: 0.35rem;
    min-height: 0;
  }

  .workspace-sidebar--collapsed .workspace-session {
    gap: 0.25rem;
  }
}

@media (max-width: 600px) {
  .workspace-frame,
  .workspace-frame--collapsed {
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
    position: relative;
  }

  .workspace-content {
    height: 100vh;
    height: 100dvh;
    padding: 0.65rem;
  }

  .panel-heading,
  .workspace-toolbar,
  .workspace-toolbar--personnel,
  .workspace-toolbar--actions,
  .workspace-toolbar--personnel-page,
  .workspace-toolbar--overtime,
  .workspace-toolbar--metrics,
  .workspace-toolbar--scheduler,
  .metrics-grid,
  .mutuals-section {
    padding-inline: 0.75rem;
  }

  .workspace-sidebar {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 30;
    width: min(18rem, calc(100vw - 1.5rem));
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow-y: auto;
    border-right: 1px solid var(--line);
    border-bottom: 0;
    gap: 1.15rem;
    padding: 0.95rem 0.85rem;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    transform: translateX(calc(-100% - 1rem));
    opacity: 0;
    pointer-events: none;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .workspace-brand-row {
    justify-content: space-between;
    gap: 0.5rem;
  }

  .workspace-brand {
    display: grid;
    padding: 0;
  }

  .workspace-nav {
    grid-auto-flow: row;
    grid-auto-columns: auto;
    overflow: visible;
    padding-bottom: 0;
    gap: 0.4rem;
  }

  .workspace-nav-link {
    justify-content: flex-start;
    min-height: 2.6rem;
    padding: 0.75rem 0.85rem;
  }

  .app-date-selector {
    justify-self: stretch;
    width: 100%;
  }

  .app-date-selector__trigger {
    width: 100%;
  }

  .app-date-selector__popover,
  .panel-heading--split .app-date-selector__popover {
    right: auto;
    left: 0;
    width: min(100%, calc(100vw - 2rem));
  }

  .metrics-section__title {
    font-size: 1.05rem;
  }

  .overtime-list {
    padding-inline: 0.75rem;
  }

  .overtime-card-title {
    font-size: 1.05rem;
  }

  .overtime-option-pills {
    display: grid;
    grid-template-columns: 1fr;
  }

  .overtime-option-pill {
    width: 100%;
    justify-content: space-between;
  }

  .metrics-card,
  .metrics-transfer-result,
  .mutual-application-row {
    padding: 0.85rem;
  }

  .mutuals-page .metrics-section__title {
    font-size: 1.02rem;
  }

  .mutual-date-summary {
    display: grid;
    grid-template-columns: 1fr;
  }

  .mutual-date-pill,
  .mutual-date-chip {
    width: 100%;
    justify-content: space-between;
  }

  .workspace-admin-scope {
    display: grid;
  }

  .workspace-admin-scope__heading strong {
    font-size: 0.86rem;
  }

  .workspace-admin-scope__heading span,
  .workspace-admin-scope__field span {
    font-size: 0.68rem;
  }

  .workspace-session {
    margin-top: auto;
    gap: 0.5rem;
    padding: 0.75rem 0.1rem 0;
    border-top: 1px solid var(--line);
  }

  .workspace-session__meta {
    display: grid;
  }

  .workspace-session__signout {
    width: 100%;
  }

  .workspace-mobile-toolbar {
    display: block;
  }

  .workspace-mobile-backdrop {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 20;
    border: 0;
    padding: 0;
    background: rgba(15, 23, 42, 0.22);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .workspace-sidebar--mobile-open {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }
}

@media print {
  :root {
    color-scheme: light;
  }

  html,
  body {
    background: white;
  }

  body {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .workspace-sidebar,
  .panel-heading,
  .workspace-toolbar,
  .set-builder,
  .schedule-wrap,
  .assignment-modal-backdrop,
  .print-preview-toolbar {
    display: none !important;
  }

  .shell,
  .workspace-frame,
  .workspace-content,
  .panel-frame {
    display: block;
    padding: 0;
    margin: 0;
    background: white !important;
    border: 0;
    box-shadow: none;
  }

  .print-schedule-stack {
    display: block;
  }

  .print-preview-page {
    padding: 0;
  }

  .print-preview-stack {
    display: block;
  }

  .print-schedule-sheet {
    padding: 0.35in 0.18in 0.35in 0.12in;
    break-after: page;
    page-break-after: always;
  }

  .print-schedule-sheet:last-child {
    break-after: auto;
    page-break-after: auto;
  }

  .print-schedule-grid .employee-header,
  .print-schedule-grid .day-header,
  .print-schedule-grid .employee-cell,
  .print-schedule-grid .shift-cell {
    position: static !important;
    left: auto !important;
    top: auto !important;
    min-height: 0;
    border: 1px solid rgba(71, 85, 105, 0.62);
    box-shadow: none !important;
    background: white !important;
  }

  .print-schedule-grid .employee-header {
    padding: 0.45rem 0.6rem;
  }

  .print-schedule-grid .day-header {
    padding: 0.25rem 0.05rem;
  }

  .print-schedule-grid .employee-cell {
    padding: 0.35rem 0.45rem;
    background: #d1d5db !important;
    font-size: 0.72rem;
  }

  .print-schedule-grid .employee-cell__main strong {
    font-size: 0.72rem;
    line-height: 1.05;
  }

  .print-schedule-grid .shift-cell-button {
    width: 100%;
    min-height: 1.9rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.68rem;
  }

  .print-schedule-grid .shift-cell {
    color: #1f2937;
    font-weight: 700;
    font-size: 0.62rem;
    border: 1px solid rgba(51, 65, 85, 0.72);
  }

  .print-schedule-grid .shift-cell--day {
    background: #fde68a !important;
  }

  .print-schedule-grid .shift-cell--night {
    background: #bfdbfe !important;
  }

  .print-schedule-grid .shift-cell--off {
    background: #e5e7eb !important;
  }

  .print-schedule-grid .shift-cell--blank {
    background: #f3f4f6 !important;
  }

  .print-schedule-grid .shift-cell--weekend {
    box-shadow: inset 0 0 0 999px rgba(255, 255, 255, 0.12) !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--amber {
    background: #fbbf24 !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--teal {
    background: #5eead4 !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--violet {
    background: #c4b5fd !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--rose {
    background: #fda4af !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--blue {
    background: #93c5fd !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--lime {
    background: #bef264 !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--orange {
    background: #fdba74 !important;
  }

  .print-schedule-grid .shift-cell.legend-pill--slate {
    background: #cbd5e1 !important;
  }

  .print-schedule-grid .employee-cell__main span {
    display: none;
  }
}

/* ============================================================
   VISUAL REFRESH 2026 — clean minimal (Apple-style)
   Scoped re-skin: app chrome + monthly scheduler.
   Reads entirely from the token system above so light/dark
   follow the OS automatically. Appended last so these win
   over the legacy warm-paper rules without editing them.
   ============================================================ */

/* ---- Canvas + scroll polish ---------------------------------- */
* {
  scrollbar-color: var(--line-strong) transparent;
}
*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
*::-webkit-scrollbar-thumb {
  background: var(--line-strong);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;
}
*::-webkit-scrollbar-thumb:hover {
  background: var(--muted);
  background-clip: padding-box;
}

/* ---- Sidebar ------------------------------------------------- */
.workspace-sidebar {
  background: var(--surface);
  border-right: 1px solid var(--line);
}
@media screen and (prefers-color-scheme: dark) {
  .workspace-sidebar {
    background: var(--surface-2);
  }
}

.workspace-brand strong {
  letter-spacing: -0.02em;
}

.workspace-nav-link {
  padding: 0.5rem 0.6rem;
  border-radius: 0.75rem;
  transition: background-color 140ms ease, color 140ms ease,
    border-color 140ms ease;
}
.workspace-nav-link:hover {
  background: var(--bg-tint);
}
.workspace-nav-icon {
  background: var(--bg-tint);
  border: 1px solid var(--line);
  color: var(--muted);
  transition: background-color 140ms ease, color 140ms ease,
    border-color 140ms ease;
}
.workspace-nav-link--active {
  background: var(--accent-soft);
  border-color: transparent;
  box-shadow: none;
  color: var(--accent-strong);
}
.workspace-nav-link--active .workspace-nav-icon {
  background: var(--accent);
  border-color: transparent;
  color: var(--accent-ink);
}
.workspace-nav-link--active strong {
  color: var(--accent-strong);
}

.workspace-admin-scope {
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

/* ---- Panels -------------------------------------------------- */
.panel-frame {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
}
.panel-title {
  letter-spacing: -0.03em;
  font-weight: 600;
}
.panel-eyebrow,
.workspace-brand span {
  color: var(--faint);
}

.summary-stat {
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

/* ---- Buttons + fields --------------------------------------- */
.primary-button,
.ghost-button,
.icon-button {
  border-radius: var(--radius-pill);
  transition: transform 140ms ease, background-color 140ms ease,
    border-color 140ms ease, box-shadow 140ms ease;
}
.primary-button {
  background: var(--accent);
  color: var(--accent-ink);
  border-color: transparent;
  box-shadow: var(--shadow-sm);
}
.primary-button:hover {
  background: var(--accent-strong);
}
.ghost-button {
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
  margin-top: 0.2rem;
}
.ghost-button:hover {
  background: var(--bg-tint);
}
.ghost-button--active {
  background: var(--accent-soft);
  border-color: transparent;
  color: var(--accent-strong);
}
.icon-button {
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
}
.icon-button:hover {
  background: var(--bg-tint);
  border-color: var(--line-strong);
}

.field span {
  color: var(--faint);
  letter-spacing: 0.04em;
}
.field select,
.field input,
.assignment-field select {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  color: var(--ink);
  box-shadow: var(--shadow-sm);
  transition: border-color 140ms ease, box-shadow 140ms ease;
}
.field select:focus,
.field input:focus,
.assignment-field select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-ring);
}

/* ---- Month stepper ------------------------------------------- */
.schedule-heading-month {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.schedule-heading-month__label {
  background: var(--surface-2);
  border-inline: 1px solid var(--line);
}
.schedule-heading-month__button {
  background: var(--surface);
  color: var(--muted);
}
.schedule-heading-month__button:hover {
  background: var(--bg-tint);
  color: var(--accent-strong);
}

/* ---- Modals -------------------------------------------------- */
.assignment-modal,
.schedule-autosave-modal,
.set-completion-modal,
.shift-order-modal,
.temporary-loan-modal {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

/* ============================================================
   MONTHLY SCHEDULER GRID
   ============================================================ */
.schedule-scroll-shell,
.schedule-wrap {
  border-radius: var(--radius-lg);
}

.employee-header,
.day-header,
.employee-cell,
.shift-cell,
.empty-state {
  border-right: 1px solid var(--grid-line);
  border-bottom: 1px solid var(--grid-line);
  background: var(--grid-cell);
}

.employee-header {
  background: var(--grid-header);
}
.employee-header strong {
  letter-spacing: -0.01em;
}

.day-header {
  background: var(--grid-header);
  transition: background-color 140ms ease, box-shadow 140ms ease,
    color 140ms ease;
}
.day-header span {
  color: var(--faint);
}
.day-header--weekend {
  background: color-mix(in srgb, var(--grid-header) 92%, var(--ink));
}
.day-header--set {
  background: var(--grid-header);
  box-shadow: inset 0 -2px 0 var(--accent);
}
.day-header--set.day-header--weekend {
  background: color-mix(in srgb, var(--grid-header) 92%, var(--ink));
}
.day-header--completed,
.day-header--completed.day-header--set {
  background: var(--state-good-soft);
  box-shadow: inset 0 -2px 0 var(--state-good);
}
.day-header--completed.day-header--weekend,
.day-header--completed.day-header--set.day-header--weekend {
  background: var(--state-good-soft);
}
.day-header--completed span,
.day-header--completed strong {
  color: var(--state-good);
}
.day-header--set-anchor {
  box-shadow: inset 0 0 0 2px var(--accent), inset 0 -2px 0 var(--accent);
}
.day-header--completed.day-header--set-anchor {
  box-shadow: inset 0 0 0 2px var(--state-good), inset 0 -2px 0 var(--state-good);
}
.day-header--missing {
  background: var(--state-warn-soft);
  box-shadow: inset 0 0 0 2px var(--state-warn), inset 0 -3px 0 var(--state-warn);
}
.day-header--missing span,
.day-header--missing strong {
  color: var(--state-warn);
}

.sticky-column {
  box-shadow: 1px 0 0 var(--grid-line);
}

.employee-cell {
  background: var(--grid-cell);
}
.employee-cell span,
.employee-cell small {
  color: var(--muted);
}
.employee-cell--selected {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}

.shift-cell--day {
  background: var(--cell-day);
}
.shift-cell--night {
  background: var(--cell-night);
}
.shift-cell--off {
  background: var(--cell-off);
}
.shift-cell--weekend {
  box-shadow: inset 0 0 0 999px var(--cell-weekend-veil);
}
.shift-cell--range {
  outline: 2px solid var(--accent-ring);
  outline-offset: -2px;
}
.shift-cell--selected {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}
.shift-cell-button {
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 0.01em;
  transition: background-color 120ms ease;
}
.shift-cell-button:hover:not(:disabled) {
  background: color-mix(in srgb, var(--accent) 8%, transparent);
}
.shift-cell-button:focus {
  box-shadow: inset 0 0 0 2px var(--accent-ring);
}
.shift-cell__note-indicator {
  background: var(--accent);
  box-shadow: 0 0 0 1px var(--surface);
}

/* Legend / set-builder pills inherit token surfaces */
.set-builder,
.set-builder__surface {
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

/* ============================================================
   VISUAL REFRESH 2026 — de-carded, full-bleed layout
   Moves away from the rounded "panel card" so content runs
   edge-to-edge and the scheduler scales to the whole viewport.
   Appended last to override the card styling above.
   ============================================================ */

/* Kill the gutter around the content card */
.workspace-content {
  padding: 0;
}

/* Flatten the panel: no border, no radius, no shadow — it IS the surface */
.panel-frame {
  border: 0;
  border-radius: 0;
  box-shadow: none;
  background: var(--surface);
  min-height: 100%;
}

/* Header + filter bar become slim sections divided by hairlines */
.panel-heading {
  padding: 0.85rem 1.25rem 0.8rem;
  border-bottom: 1px solid var(--line);
  align-items: center;
}
.panel-heading--simple {
  border-bottom: 1px solid var(--line);
}
.workspace-toolbar {
  padding: 0.8rem 1.25rem;
  border-bottom: 1px solid var(--line);
  align-items: end;
}

/* Stat blocks: from boxed cards to a clean divided strip */
.summary-row {
  padding: 0;
  gap: 0;
  border-bottom: 1px solid var(--line);
}
.summary-stat {
  background: transparent;
  border: 0;
  border-right: 1px solid var(--line);
  border-radius: 0;
  padding: 0.8rem 1.25rem;
}

/* ---- Scheduler fills the viewport, grid scrolls internally ---- */
.workspace-content:has(.schedule-scroll-shell) {
  overflow: hidden;
}
.panel-frame:has(.schedule-scroll-shell) {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.panel-frame:has(.schedule-scroll-shell) > .panel-heading,
.panel-frame:has(.schedule-scroll-shell) > .workspace-toolbar,
.panel-frame:has(.schedule-scroll-shell) > .set-builder {
  flex: 0 0 auto;
}
.schedule-scroll-shell {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.schedule-scroll-shell > .schedule-wrap:not(.schedule-wrap--top-scroll) {
  flex: 1 1 auto;
  min-height: 0;
  padding-bottom: 0;
}

/* Grid runs flush to the panel edges (no rounded card around it) */
.schedule-scroll-shell,
.schedule-wrap {
  border-radius: 0;
}

/* Slimmer, flatter filter pills inside the dense toolbar */
.field select,
.field input,
.assignment-field select {
  min-height: 2.4rem;
  box-shadow: none;
}
.set-builder,
.set-builder__surface {
  border-radius: 0;
  border-left: 0;
  border-right: 0;
  border-top: 0;
}

/* ============================================================
   VISUAL REFRESH 2026 — rollout across all screens
   Maps every per-screen card / row / table / modal surface to
   the token system so each screen is clean in light and correct
   in dark. Appended last to win over legacy warm/white values.
   ============================================================ */

/* Primary cards, panels, modals --------------------------------- */
.auth-home__panel,
.auth-panel,
.auth-account,
.profile-card,
.personnel-actions-menu__panel,
.metrics-card,
.metrics-transfer-result,
.metrics-transfer-projection,
.metrics-transfer-competency-group,
.overtime-card,
.overtime-eligibility-modal__summary,
.invite-builder,
.import-preview,
.workspace-notification-item,
.personnel-cleanup-modal,
.metrics-competency-modal,
.metrics-overtime-modal,
.overtime-eligibility-modal,
.overtime-my-claims-modal {
  background: var(--surface);
  border-color: var(--line);
  box-shadow: none;
}

/* Secondary rows, options, chips, tracks ------------------------ */
.auth-selection-note,
.metrics-settings-option,
.metrics-competency-modal__row,
.metrics-overtime-modal__row,
.metrics-transfer-competency-option,
.overtime-eligibility-modal__row,
.overtime-my-claims-modal__row,
.overtime-calendar-day,
.mutual-date-chip,
.mutual-application-row,
.temporary-loan-date,
.shift-order-row,
.personnel-cleanup-modal__row,
.set-completion-modal__row,
.table-select,
.table-code,
.table-action,
.field--static strong,
.import-preview__row,
.subschedule-grid-wrap,
.overtime-option-pill {
  background: var(--surface-2);
  border-color: var(--line);
}

.metrics-bar-track {
  background: var(--bg-tint);
}
.overtime-option-pill--active {
  background: var(--accent-soft);
  border-color: transparent;
  color: var(--accent-strong);
  box-shadow: none;
}

/* Small controls ------------------------------------------------ */
.sidebar-toggle,
.workspace-admin-scope__chevron,
.workspace-mobile-toggle__icon {
  background: var(--surface);
  border-color: var(--line);
}
.sidebar-toggle:hover,
.workspace-admin-scope__toggle:hover .workspace-admin-scope__chevron {
  background: var(--bg-tint);
}

/* Tables -------------------------------------------------------- */
.personnel-table td,
.subschedule-table td {
  background: var(--surface);
  border-color: var(--line);
}
.personnel-table th,
.subschedule-table th {
  background: var(--surface-2);
  border-color: var(--line);
  color: var(--muted);
}
.personnel-table tr:hover td {
  background: var(--bg-tint);
}

/* Landing / marketing surfaces ---------------------------------- */
.landing-band,
.landing-cta,
.landing-blueprint,
.landing-blueprint__roles,
.landing-blueprint__grid,
.landing-role-grid article {
  background: var(--surface);
  border-color: var(--line);
}
.landing-hero__copy p,
.landing-band p,
.landing-detail p,
.landing-cta p {
  color: var(--muted);
}

/* Final stragglers ---------------------------------------------- */
.metrics-month-nav__current strong,
.set-builder-legend__item,
.loading-block {
  background: var(--surface-2);
  border-color: var(--line);
}
.loading-block {
  background: linear-gradient(
    100deg,
    var(--surface-2) 30%,
    var(--bg-tint) 50%,
    var(--surface-2) 70%
  );
}
.assignment-modal__note-input {
  background: var(--surface);
  border-color: var(--line);
  color: var(--ink);
}
.schedule-autosave-modal {
  background: var(--surface);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-lg);
}
.schedule-autosave-modal--saved {
  background: var(--state-good-soft);
  border-color: color-mix(in srgb, var(--state-good) 40%, transparent);
}
.schedule-autosave-modal--error {
  background: var(--state-warn-soft);
  border-color: color-mix(in srgb, var(--state-warn) 45%, transparent);
}

/* ============================================================
   VISUAL REFRESH 2026 — pill treatment B + tonal hue ramps
   Flat tint + hairline border + same-hue dark text.
   One token trio per hue, auto-flipping for dark mode.
   ============================================================ */
:root {
  --hue-amber-fill: #faeeda;  --hue-amber-border: rgba(186, 117, 23, 0.34);  --hue-amber-text: #854f0b;
  --hue-teal-fill: #e1f5ee;   --hue-teal-border: rgba(15, 110, 86, 0.32);    --hue-teal-text: #0f6e56;
  --hue-violet-fill: #eeedfe; --hue-violet-border: rgba(83, 74, 183, 0.30);  --hue-violet-text: #3c3489;
  --hue-rose-fill: #fbeaf0;   --hue-rose-border: rgba(153, 53, 86, 0.30);    --hue-rose-text: #993556;
  --hue-blue-fill: #e6f1fb;   --hue-blue-border: rgba(24, 95, 165, 0.30);    --hue-blue-text: #185fa5;
  --hue-lime-fill: #eaf3de;   --hue-lime-border: rgba(59, 109, 17, 0.32);    --hue-lime-text: #3b6d11;
  --hue-orange-fill: #faece7; --hue-orange-border: rgba(153, 60, 29, 0.30);  --hue-orange-text: #993c1d;
  --hue-slate-fill: #edf0f4;  --hue-slate-border: rgba(71, 85, 105, 0.28);   --hue-slate-text: #334155;
}
@media screen and (prefers-color-scheme: dark) {
  :root {
    --hue-amber-fill: rgba(239, 159, 39, 0.18);  --hue-amber-border: rgba(239, 159, 39, 0.40);  --hue-amber-text: #fac775;
    --hue-teal-fill: rgba(29, 158, 117, 0.18);   --hue-teal-border: rgba(29, 158, 117, 0.40);   --hue-teal-text: #9fe1cb;
    --hue-violet-fill: rgba(127, 119, 221, 0.20);--hue-violet-border: rgba(127, 119, 221, 0.42);--hue-violet-text: #cecbf6;
    --hue-rose-fill: rgba(212, 83, 126, 0.18);   --hue-rose-border: rgba(212, 83, 126, 0.40);   --hue-rose-text: #f4c0d1;
    --hue-blue-fill: rgba(55, 138, 221, 0.18);   --hue-blue-border: rgba(55, 138, 221, 0.42);   --hue-blue-text: #b5d4f4;
    --hue-lime-fill: rgba(99, 153, 34, 0.20);    --hue-lime-border: rgba(99, 153, 34, 0.42);    --hue-lime-text: #c0dd97;
    --hue-orange-fill: rgba(216, 90, 48, 0.20);  --hue-orange-border: rgba(216, 90, 48, 0.42);  --hue-orange-text: #f5c4b3;
    --hue-slate-fill: rgba(148, 163, 184, 0.16); --hue-slate-border: rgba(148, 163, 184, 0.34); --hue-slate-text: #cbd5e1;
  }
}

/* Legend / competency chips ------------------------------------- */
.legend-pill {
  border: 0.5px solid transparent;
  font-weight: 500;
}
.legend-pill--amber  { background: var(--hue-amber-fill);  border-color: var(--hue-amber-border);  color: var(--hue-amber-text); }
.legend-pill--teal   { background: var(--hue-teal-fill);   border-color: var(--hue-teal-border);   color: var(--hue-teal-text); }
.legend-pill--violet { background: var(--hue-violet-fill); border-color: var(--hue-violet-border); color: var(--hue-violet-text); }
.legend-pill--rose   { background: var(--hue-rose-fill);   border-color: var(--hue-rose-border);   color: var(--hue-rose-text); }
.legend-pill--blue   { background: var(--hue-blue-fill);   border-color: var(--hue-blue-border);   color: var(--hue-blue-text); }
.legend-pill--lime   { background: var(--hue-lime-fill);   border-color: var(--hue-lime-border);   color: var(--hue-lime-text); }
.legend-pill--orange { background: var(--hue-orange-fill); border-color: var(--hue-orange-border); color: var(--hue-orange-text); }
.legend-pill--slate  { background: var(--hue-slate-fill);  border-color: var(--hue-slate-border);  color: var(--hue-slate-text); }

/* Shift-cell competency fills: flat tint (no gradient) ---------- */
.shift-cell.legend-pill--amber  { background: var(--hue-amber-fill); }
.shift-cell.legend-pill--teal   { background: var(--hue-teal-fill); }
.shift-cell.legend-pill--violet { background: var(--hue-violet-fill); }
.shift-cell.legend-pill--rose   { background: var(--hue-rose-fill); }
.shift-cell.legend-pill--blue   { background: var(--hue-blue-fill); }
.shift-cell.legend-pill--lime   { background: var(--hue-lime-fill); }
.shift-cell.legend-pill--orange { background: var(--hue-orange-fill); }
.shift-cell.legend-pill--slate  { background: var(--hue-slate-fill); }

/* Cell label text takes the hue's dark shade -------------------- */
.shift-cell-button.legend-pill--amber  { color: var(--hue-amber-text); }
.shift-cell-button.legend-pill--teal   { color: var(--hue-teal-text); }
.shift-cell-button.legend-pill--violet { color: var(--hue-violet-text); }
.shift-cell-button.legend-pill--rose   { color: var(--hue-rose-text); }
.shift-cell-button.legend-pill--blue   { color: var(--hue-blue-text); }
.shift-cell-button.legend-pill--lime   { color: var(--hue-lime-text); }
.shift-cell-button.legend-pill--orange { color: var(--hue-orange-text); }
.shift-cell-button.legend-pill--slate  { color: var(--hue-slate-text); }

/* ============================================================
   VISUAL REFRESH 2026 — unified date selector (month / year)
   Labeled-pill trigger + clean card popover + accent-soft
   selected state. One look across every page, both modes.
   ============================================================ */

/* Trigger: reads like the toolbar field pills ------------------- */
.app-date-selector__trigger {
  min-width: auto;
  gap: 0.02rem 0.6rem;
  padding: 0.4rem 0.75rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  box-shadow: var(--shadow-sm);
  transition: background-color 140ms ease, border-color 140ms ease,
    box-shadow 140ms ease;
}
.app-date-selector__trigger:hover {
  background: var(--bg-tint);
  border-color: var(--line-strong);
}
.app-date-selector__trigger:focus-visible {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-ring);
}
.app-date-selector__trigger strong,
.workspace-toolbar .app-date-selector__trigger strong {
  font-family: var(--font-body), sans-serif;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.app-date-selector__eyebrow {
  color: var(--faint);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.06em;
}
.app-date-selector__trigger svg {
  width: 1rem;
  height: 1rem;
  color: var(--muted);
  stroke-width: 2;
}

/* Popover: clean elevated card ---------------------------------- */
.app-date-selector__popover,
.panel-heading--split .app-date-selector__popover {
  width: min(17rem, calc(100vw - 2rem));
  gap: 0.7rem;
  padding: 0.75rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-lg);
}

/* Year stepper header ------------------------------------------- */
.app-date-selector__header {
  grid-template-columns: 2rem minmax(0, 1fr) 2rem;
  gap: 0.4rem;
}
.app-date-selector__header strong {
  font-family: var(--font-body), sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--ink);
}
.app-date-selector__header button {
  min-height: 1.9rem;
  font: 500 1.15rem/1 var(--font-body), sans-serif;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  color: var(--muted);
}

/* Month / year options ------------------------------------------ */
.app-date-selector__grid {
  gap: 0.4rem;
}
.app-date-selector__option {
  min-height: 2.3rem;
  padding: 0.4rem 0.5rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  color: var(--ink);
  font-weight: 400;
  font-size: 0.85rem;
}
.app-date-selector__header button:hover,
.app-date-selector__option:hover {
  background: var(--bg-tint);
  border-color: var(--line-strong);
}
.app-date-selector__option--selected {
  background: var(--accent-soft);
  border-color: transparent;
  color: var(--accent-strong);
  font-weight: 500;
  box-shadow: inset 0 0 0 1px var(--accent);
}
.app-date-selector__option:disabled {
  cursor: not-allowed;
  opacity: 0.35;
}

/* ============================================================
   FIX — overtime option pill selected state
   The pill carries both .legend-pill--{hue} (treatment B) and
   .overtime-option-pill--active. Same specificity meant the hue
   colour masked the active state. Raise specificity so the
   selected pill clearly switches to the accent-soft treatment.
   ============================================================ */
.overtime-option-pill.overtime-option-pill--active {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-strong);
  box-shadow: inset 0 0 0 1px var(--accent);
}
.overtime-option-pill.overtime-option-pill--active strong,
.overtime-option-pill.overtime-option-pill--active span {
  color: var(--accent-strong);
}

/* FIX — right-anchor date popovers placed on the right edge -------- */
.mutuals-year-pager .app-date-selector__popover,
.panel-heading .app-date-selector.mutuals-year-pager .app-date-selector__popover {
  right: 0;
  left: auto;
}

/* ============================================================
   VISUAL REFRESH 2026 — metrics page alignment
   Flatten gradient bars, switch warm selected states to the
   accent-soft language, make fatigue text dark-mode legible.
   ============================================================ */

/* Flat bar fills (no gradients) --------------------------------- */
.metrics-bar-fill--amber     { background: #eaa531; }
.metrics-bar-fill--teal      { background: #14b8a6; }
.metrics-bar-fill--violet    { background: #8b5cf6; }
.metrics-bar-fill--rose      { background: #f43f5e; }
.metrics-bar-fill--blue      { background: #2f7fd6; }
.metrics-bar-fill--lime      { background: #84cc16; }
.metrics-bar-fill--orange    { background: #f97316; }
.metrics-bar-fill--slate     { background: #64748b; }
.metrics-bar-fill--overtime  { background: #be185d; }
.metrics-bar-fill--fragility { background: #c2410c; }

/* Selected / hover states → accent-soft, like everywhere else --- */
.metrics-settings-option--active,
.metrics-transfer-competency-option--active {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-strong);
  box-shadow: inset 0 0 0 1px var(--accent);
}
.metrics-settings-option:hover,
.metrics-transfer-competency-option:hover {
  background: var(--bg-tint);
  border-color: var(--line-strong);
}
.metrics-card--interactive:focus-visible {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-ring);
}
.metrics-bar-row--interactive:focus-visible .metrics-bar-track {
  box-shadow: 0 0 0 2px var(--accent-ring);
}

/* Fatigue bands legible in dark mode ---------------------------- */
@media screen and (prefers-color-scheme: dark) {
  .metrics-fatigue-band--green    { color: #4ade80; }
  .metrics-fatigue-band--amber    { color: #fbbf24; }
  .metrics-fatigue-band--red      { color: #f87171; }
  .metrics-fatigue-band--critical { color: #c4b5fd; }
}

/* ============================================================
   VISUAL REFRESH 2026 — metrics sweep (final alignment)
   Normalise radii to the token scale, soften heavy weights,
   refine titles, neutralise the loading skeleton.
   ============================================================ */

/* Corner radii on the token scale ------------------------------- */
.metrics-card { border-radius: var(--radius-lg); }
.metrics-competency-modal__row,
.metrics-overtime-modal__row,
.metrics-transfer-competency-group,
.metrics-settings-option { border-radius: var(--radius); }
.metrics-fatigue-band { border-radius: var(--radius-sm); }

/* Lighter weights to match the clean language ------------------- */
.metrics-fatigue-band {
  font-weight: 500;
  letter-spacing: 0.02em;
}
.metrics-transfer-competency-summary { font-weight: 500; }

/* Section / card titles tuned like panel titles ----------------- */
.metrics-section__title,
.metrics-card__title {
  font-weight: 600;
  letter-spacing: -0.01em;
}

/* Loading skeleton uses tokens too ------------------------------ */
.metrics-month-nav__current strong {
  background: var(--surface-2);
  border-color: var(--line);
}

/* ============================================================
   FIX — schedule fills remaining height as a flex column so the
   mobile "Open Menu" toolbar keeps its space and the grid stays
   reachable (replaces the fixed height:100% that ignored siblings).
   ============================================================ */
.workspace-content:has(.schedule-scroll-shell) {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.workspace-content:has(.schedule-scroll-shell) .workspace-mobile-toolbar {
  flex: 0 0 auto;
}
.panel-frame:has(.schedule-scroll-shell) {
  height: auto;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ============================================================
   Scheduler — single combined toolbar (date + filters + actions)
   Replaces the stacked panel-heading + filter bar to reclaim
   vertical space for the grid.
   ============================================================ */
.scheduler-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem 0.85rem;
  padding: 0.6rem clamp(0.75rem, 2vw, 1.25rem);
  border-bottom: 1px solid var(--line);
}
.scheduler-toolbar .app-date-selector {
  flex: 0 0 auto;
}
.scheduler-toolbar .field {
  flex: 0 1 13rem;
  min-width: 9rem;
}
.scheduler-toolbar .field--static {
  flex: 0 0 auto;
}
.scheduler-toolbar .toolbar-status-wrap {
  flex: 1 1 5rem;
  min-width: 0;
}
.scheduler-toolbar__actions {
  flex: 0 0 auto;
  margin-left: auto;
}
.panel-frame:has(.schedule-scroll-shell) > .scheduler-toolbar {
  flex: 0 0 auto;
}

/* ============================================================
   Mobile menu toggle — compact + subtle so it doesn't block
   the top of the screen. Icon-only; label kept for a11y.
   ============================================================ */
@media (max-width: 600px) {
  .workspace-mobile-toolbar {
    padding: 0.2rem 0 0;
  }
  .workspace-mobile-toggle.ghost-button {
    min-height: 0;
    padding: 0.2rem;
    gap: 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }
  .workspace-mobile-toggle:hover.ghost-button {
    background: transparent;
  }
  .workspace-mobile-toggle__icon {
    width: 2rem;
    height: 2rem;
  }
  /* Keep the "Open/Close Menu" text for screen readers, hide it visually */
  .workspace-mobile-toggle strong {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
}

/* ============================================================
   Set builder — collapsible
   ============================================================ */
.set-builder__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  width: 100%;
  padding: 0 0.1rem 0.55rem;
  border: 0;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-family: var(--font-body), sans-serif;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.set-builder__toggle:hover {
  color: var(--ink);
}
.set-builder__chevron {
  width: 1.05rem;
  height: 1.05rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform 160ms ease;
}
.set-builder--collapsed .set-builder__chevron {
  transform: rotate(-90deg);
}
.set-builder--collapsed .set-builder__toggle {
  padding-bottom: 0;
}
.set-builder--collapsed .set-builder-heading,
.set-builder--collapsed .set-builder-pills {
  display: none;
}

/* ============================================================
   Schedule crosshair — hovering a cell tints the matching
   date header + worker-name cell with the same accent tone.
   (background-image layer keeps each element's own background.)
   ============================================================ */
.day-header--xhover,
.employee-cell--xhover {
  background-image: linear-gradient(
    color-mix(in srgb, var(--accent) 8%, transparent),
    color-mix(in srgb, var(--accent) 8%, transparent)
  );
}

/* ============================================================
   DARK MODE batch — form fields + danger/add controls
   ============================================================ */
:root {
  --danger: #b91c1c;
  --danger-soft: rgba(185, 28, 28, 0.10);
  --danger-border: rgba(185, 28, 28, 0.26);
}
@media screen and (prefers-color-scheme: dark) {
  :root {
    --danger: #f87171;
    --danger-soft: rgba(248, 113, 113, 0.14);
    --danger-border: rgba(248, 113, 113, 0.32);
  }
}

/* Bare inputs across Personnel, Shifts, Competencies, Time codes,
   Sub-schedules now follow the token palette instead of browser white. */
input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
select,
textarea {
  background-color: var(--surface);
  color: var(--ink);
  border-color: var(--line);
}
input::placeholder,
textarea::placeholder {
  color: var(--faint);
  opacity: 1;
}

/* Classed fields that were hardcoded white */
.assignment-field select {
  background: var(--surface);
}
.assignment-field select:focus,
.table-select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-ring);
}
.assignment-modal__note-input:focus {
  outline: 2px solid var(--accent-ring);
}
.table-row--selected td {
  background: var(--accent-soft);
}

/* Sub-schedules — "add worker" button */
.subschedule-add-row__button {
  background: var(--accent-soft);
  border-color: color-mix(in srgb, var(--accent) 48%, var(--line));
}

/* Delete sub-schedule danger section + danger actions */
.assignment-modal__danger-zone {
  background: var(--danger-soft);
  border-color: var(--danger-border);
}
.assignment-modal__danger-zone strong {
  color: var(--danger);
}
.table-action--danger {
  color: var(--danger);
}

/* ============================================================
   Scheduler month selector — drop the eyebrow label, larger date
   ============================================================ */
.scheduler-toolbar .app-date-selector__eyebrow {
  display: none;
}
.scheduler-toolbar .app-date-selector__trigger strong {
  font-size: 1.6rem;
  line-height: 1.05;
  letter-spacing: -0.02em;
}

/* ============================================================
   Remove the on-click selection outlines on the cell, the
   worker-name cell, and the date header. Keep a keyboard-only
   focus ring on cells for accessibility.
   ============================================================ */
.shift-cell--selected {
  outline: none;
}
.employee-cell--selected {
  outline: none;
}
.day-header--set-anchor {
  box-shadow: inset 0 -2px 0 var(--accent);
}
.day-header--completed.day-header--set-anchor {
  box-shadow: inset 0 -2px 0 var(--state-good);
}
.shift-cell-button:focus {
  box-shadow: none;
}
.shift-cell-button:focus-visible {
  box-shadow: inset 0 0 0 2px var(--accent-ring);
}

/* ============================================================
   Print — default to Legal, landscape; never carry dark mode.
   (Dark tokens are scoped to `screen`, so print uses the light
   palette automatically.)
   ============================================================ */
@page {
  size: legal landscape;
  margin: 0.4in;
}

/* ============================================================
   Date selector — apply the scheduler update everywhere:
   no eyebrow label, larger date value (metrics, overtime,
   mutuals, sub-schedules, scheduler).
   ============================================================ */
.app-date-selector__eyebrow {
  display: none;
}
.app-date-selector__trigger strong,
.workspace-toolbar .app-date-selector__trigger strong {
  font-size: 1.6rem;
  line-height: 1.05;
  letter-spacing: -0.02em;
}

/* ============================================================
   Scheduler toolbar — "Filters" collapses like the set builder.
   The toggle is a full-width header row; the date selector and
   action icons stay on the top line, the filter fields fold below.
   ============================================================ */
.scheduler-toolbar .app-date-selector {
  order: 0;
}
.scheduler-toolbar__actions {
  order: 1;
}
.scheduler-toolbar__toggle {
  order: 2;
  flex: 1 0 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin: 0.15rem 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-family: var(--font-body), sans-serif;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.scheduler-toolbar__toggle:hover {
  color: var(--ink);
}
.scheduler-toolbar__toggle svg {
  width: 1.05rem;
  height: 1.05rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform 160ms ease;
}
.scheduler-toolbar .field,
.scheduler-toolbar .toolbar-status-wrap {
  order: 3;
}
.scheduler-toolbar--collapsed .scheduler-toolbar__toggle svg {
  transform: rotate(-90deg);
}
.scheduler-toolbar--collapsed .field,
.scheduler-toolbar--collapsed .toolbar-status-wrap {
  display: none;
}

/* ============================================================
   Mobile menu — floating icon only; app flows to the very top.
   The toolbar is taken out of flow so the grid reaches the top
   edge; just a round menu icon floats over the content, with no
   reserved safe-area gap.
   ============================================================ */
@media (max-width: 600px) {
  .workspace-mobile-toolbar {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 26;
    padding: 0;
    pointer-events: none;
  }
  .workspace-mobile-toggle.ghost-button {
    pointer-events: auto;
    margin: 0.5rem 0 0 0.5rem;
    min-height: 0;
    padding: 0.4rem 0.9rem 0.4rem 0.6rem;
    gap: 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-md);
  }
  .workspace-mobile-toggle.ghost-button:hover {
    background: var(--bg-tint);
  }
  /* Pill with visible label, matching the app's button style */
  .workspace-mobile-toggle strong {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    clip: auto;
    white-space: nowrap;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .workspace-mobile-toggle__icon {
    width: 1.35rem;
    height: 1.35rem;
    background: transparent;
    border: 0;
    color: var(--ink);
  }
}

/* ============================================================
   FIX — temporary loan selected date highlight
   The rollout's .temporary-loan-date background was sourced after
   the --selected rule and masked it. Re-assert the selected state.
   ============================================================ */
.temporary-loan-date--selected {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-strong);
  box-shadow: inset 0 0 0 1px var(--accent);
}
.temporary-loan-date--selected strong,
.temporary-loan-date--selected span {
  color: var(--accent-strong);
}

/* ============================================================
   Sweep — re-assert state backgrounds the rollout base classes
   masked (legend understaffed, empty calendar day, dragging row).
   ============================================================ */
.set-builder-legend__item--under {
  background: var(--hue-slate-fill);
}
.overtime-calendar-day--empty {
  background: var(--bg-tint);
}
.shift-order-row--dragging {
  border-color: var(--accent);
  background: var(--accent-soft);
}

/* ============================================================
   Metrics — overtime + fragility bars aligned to app semantics
   (overtime = warm amber/load, fragility = red/risk).
   ============================================================ */
.metrics-bar-fill--overtime {
  background: #d97706;
}
.metrics-bar-fill--fragility {
  background: #dc2626;
}

/* ============================================================
   Mobile — clear the floating Menu button so it doesn't cover
   the date selector / page header.
   ============================================================ */
@media (max-width: 600px) {
  .scheduler-toolbar,
  .panel-heading {
    padding-top: 3.1rem;
  }
}

/* ============================================================
   Shifts page — icon action buttons (add / revert / save),
   kept inline on every size including mobile.
   ============================================================ */
.planner-actions--icons {
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 0.5rem;
}
.schedules-save-button.icon-button {
  background: var(--accent);
  border-color: transparent;
  color: var(--accent-ink);
}
.schedules-save-button.icon-button:hover {
  background: var(--accent-strong);
}
@media (max-width: 600px) {
  .workspace-toolbar--actions .planner-actions--icons {
    flex-direction: row;
    flex-wrap: nowrap;
  }
}

/* Mutuals — worker search bar */
.mutuals-search-bar {
  padding-top: 0;
}
.mutuals-search-bar .field {
  max-width: 24rem;
}
@media (max-width: 600px) {
  .mutuals-search-bar .field {
    max-width: 100%;
  }
}

/* Sub-schedules — status line (toolbar shell removed) */
.subschedule-builder-status {
  padding: 0 clamp(0.75rem, 2vw, 1.25rem);
}
.subschedule-builder-status:empty {
  display: none;
}
